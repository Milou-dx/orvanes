---
import { GLYPHS, type IconName } from './glyphs';

interface Props { name: IconName; size?: number; class?: string; }
const { name, size = 16, class: className = '' } = Astro.props;
---
<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  aria-hidden="true"
  set:html={GLYPHS[name]}
/>

<style>
  .icon { flex-shrink: 0; }
</style>
