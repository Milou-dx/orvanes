---
import { GLYPHS, type IconName } from './glyphs';
import { DUOTONE } from './glyphs-duotone';

// duotone : réservé aux tuiles du Dock ; partout ailleurs, la graisse Bold.
interface Props { name: IconName; size?: number; class?: string; duotone?: boolean; }
const { name, size = 16, class: className = '', duotone = false } = Astro.props;
---
<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  aria-hidden="true"
  set:html={(duotone ? DUOTONE : GLYPHS)[name]}
/>

<style>
  .icon { flex-shrink: 0; }
</style>
