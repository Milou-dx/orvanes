---
interface Props { size?: number; label?: string; class?: string }
const { size = 16, label, class: className = '' } = Astro.props;
---
<span
  class:list={['spinner', className]}
  style={`--spin:${size}px`}
  role={label ? 'status' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
></span>

<style>
  .spinner {
    display: inline-block; flex: none; width: var(--spin); height: var(--spin);
    border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent;
    opacity: 0.8; animation: n-spin 0.7s linear infinite;
  }
</style>
