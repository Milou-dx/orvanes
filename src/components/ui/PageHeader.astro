---
interface Props { title: string; description?: string }
const { title, description } = Astro.props;
---
<header class="phead">
  <div class="phead__titles">
    <h1 class="phead__title">{title}</h1>
    {description && <p class="phead__desc">{description}</p>}
  </div>
  {Astro.slots.has('actions') && <div class="phead__actions"><slot name="actions" /></div>}
</header>

<style>
  /* La barre d'en-tête d'une fenêtre de mistraOS (AdwHeaderBar) : titre et sous-titre au centre, actions au bout. */
  .phead {
    position: sticky; top: 0; z-index: var(--z-sticky); flex-shrink: 0;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, auto) minmax(0, 1fr); align-items: center; gap: var(--space-3);
    min-height: var(--headerbar-h); padding: var(--space-1) var(--page-gutter);
    background: var(--bg-app);
  }
  .phead__titles { grid-column: 2; display: flex; flex-direction: column; align-items: center; min-width: 0; text-align: center; }
  .phead__title {
    max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-size: var(--dense-size); line-height: var(--dense-lh); font-weight: var(--weight-bold); color: var(--text-primary);
  }
  .phead__desc {
    max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-size: var(--meta-size); line-height: var(--meta-lh); color: var(--text-secondary);
  }
  .phead__actions { grid-column: 3; justify-self: end; display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-2); min-width: 0; }
  @media (max-width: 640px) {
    .phead { grid-template-columns: minmax(0, 1fr) auto; }
    .phead__titles { grid-column: 1; align-items: flex-start; text-align: left; }
    .phead__actions { grid-column: 2; }
    .phead__actions > :global(*) { flex-wrap: wrap; max-width: 100%; }
  }
</style>
