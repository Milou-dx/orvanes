---
import type { IconName } from './glyphs';
interface Props { name: IconName; size?: number; class?: string; }
const { name, size = 16, class: className = '' } = Astro.props;
---
<svg class:list={['icon', className]} width={size} height={size} fill="currentColor" aria-hidden="true"><use href={`#ic-${name}`} /></svg>

<style>
  .icon { flex-shrink: 0; }
</style>
