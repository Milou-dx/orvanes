---
import Icon from './Icon.astro';
import type { IconName } from './glyphs';

interface Props {
  title: string;
  desc?: string;
  icon?: IconName;
  tint?: string;
  href?: string;
  class?: string;
}
const { title, desc, icon, tint, href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
// Tuile neutre, comme les icônes monochromes de mistraOS ; seule une icône d'état prend sa couleur.
const STATE: Partial<Record<IconName, string>> = {
  check: '--success', circleCheck: '--success', warning: '--warning', circleAlert: '--warning', circleX: '--danger',
};
const color = tint ?? (icon && STATE[icon]);
---
<Tag class:list={['srow', href && 'srow--link', !icon && 'srow--plain', className]} href={href} data-astro-prefetch={href ? 'hover' : undefined}>
  {icon && <span class="srow__tile" style={color ? `color: var(${color}, var(--text-primary))` : undefined} aria-hidden="true"><Icon name={icon} size={16} /></span>}
  <span class="srow__txt">
    <span class="srow__title">{title}</span>
    {desc && <span class="srow__desc">{desc}</span>}
  </span>
  {Astro.slots.has('default') && <span class="srow__end"><slot /></span>}
  {href && <span class="srow__chev" aria-hidden="true"><Icon name="chevronRight" size={16} /></span>}
</Tag>
