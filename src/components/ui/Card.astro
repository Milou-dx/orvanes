---
import type { IconName } from './glyphs';

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  flush?: boolean;
  icon?: IconName;
  interactive?: boolean;
  class?: string;
  id?: string;
}
const { title, description, eyebrow, flush = false, interactive = false, class: className = '', id } = Astro.props;
const heading = title ?? eyebrow;
const hasHeader = Boolean(heading || description || Astro.slots.has('actions'));
---
<section id={id} class:list={['card', flush && 'card--flush', interactive && 'card--interactive', className]}>
  {hasHeader && (
    <header class="card__head">
      <div class="card__titles">
        {heading && <h2 class="t-card card__title">{heading}</h2>}
        {description && <p class="card__desc">{description}</p>}
      </div>
      {Astro.slots.has('actions') && (
        <div class="card__actions"><slot name="actions" /></div>
      )}
    </header>
  )}
  <div class="card__body"><slot /></div>
</section>

<style>
  /* Un groupe de Réglages de mistraOS (AdwPreferencesGroup) : le titre au-dessus, le contenu dans la liste arrondie. */
  .card { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .card--interactive { cursor: pointer; }
  .card--interactive .card__body { transition: background-color var(--dur-fast) var(--ease-out); }
  .card--interactive:hover .card__body { background: var(--bg-hover); }
  .card__head { display: flex; align-items: center; gap: var(--space-2); padding: 0 var(--space-1); }
  .card__titles { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .card__title {
    font-size: var(--dense-size); line-height: var(--dense-lh);
    font-weight: var(--weight-bold); color: var(--text-primary); text-wrap: balance;
  }
  .card__desc { font-size: var(--meta-size); line-height: var(--meta-lh); color: var(--text-secondary); text-wrap: pretty; }
  .card__actions { display: flex; align-items: center; gap: var(--space-2); flex-shrink: 0; margin-left: auto; }
  .card__body {
    padding: var(--space-4) var(--space-3); min-width: 0;
    background: var(--bg-surface); border-radius: var(--radius-card); overflow: hidden;
  }
  .card--flush .card__body { padding: 0; }
  @media (max-width: 640px) {
    .card__head { flex-wrap: wrap; row-gap: var(--space-2); }
    .card__titles { flex: 1 1 10rem; }
    .card__actions { flex-wrap: wrap; flex-shrink: 1; min-width: 0; }
  }
</style>
