---
/** Explorateur façon Finder : barre latérale (Favoris, Emplacements), vues Icônes et Liste, barre de chemin, Coup d'œil (Espace) et édition des fichiers texte (admins). */
import { existsSync } from 'node:fs';
import { homedir } from 'node:os';
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/vault.css';
import * as sys from '../server/system/system.js';
import { safe } from '../server/core/safe';
import { bytes, percent } from '../server/core/format';

export const prerender = false;

const disks = await safe(() => sys.getDisks(), [] as any[]);
const cwd = Astro.url.searchParams.get('path') ?? '/';
const admin = Astro.locals.user?.role === 'admin';
const home = homedir();
const favorites = [
  { path: '/', label: 'Racine', icon: 'hardDrive' },
  { path: home, label: 'Dossier personnel', icon: 'house' },
  { path: `${home}/dev`, label: 'Projets', icon: 'folder' },
  { path: '/etc', label: 'Configuration', icon: 'settings' },
  { path: '/var/log', label: 'Journaux', icon: 'logs' },
  { path: '/tmp', label: 'Temporaire', icon: 'clock' },
].filter((f, i, all) => existsSync(f.path) && all.findIndex((o) => o.path === f.path) === i);
---
<PanelLayout title="Fichiers" refreshMs={null}>
  <div id="fx" class="v-page v-page--wide fx" data-cwd={cwd} data-admin={admin ? '1' : '0'}>
    <div id="fx-upload" class="v-alert fx-upload" role="status" hidden>
      <div class="fx-upload__bar" role="progressbar" aria-label="Progression du téléversement" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div id="fx-upload-fill" class="fx-upload__fill"></div></div>
      <p id="fx-upload-msg" class="fx-upload__msg"></p>
      <button type="button" class="v-btn v-btn--sm v-btn--outline" id="fx-upload-close">Fermer</button>
    </div>

    <div class="fx-win">
      <nav class="fx-side" id="fx-nav" aria-label="Barre latérale">
        <p class="fx-side__h" id="fx-fav-h">Favoris</p>
        <ul class="fx-side__list" aria-labelledby="fx-fav-h">
          {favorites.map((f) => (
            <li><button type="button" class="fx-place" data-path={f.path} title={f.path}><Icon name={f.icon as any} size={16} /><span class="fx-place__t">{f.label}</span></button></li>
          ))}
        </ul>
        <p class="fx-side__h" id="fx-loc-h">Emplacements</p>
        <ul class="fx-side__list" aria-labelledby="fx-loc-h">
          {disks.map((d: any) => (
            <li>
              <button type="button" class="fx-place fx-place--disk" data-path={d.path} data-free={bytes(d.freeBytes)} title={`${bytes(d.freeBytes)} libres sur ${bytes(d.totalBytes)}`}>
                <Icon name="hardDrive" size={16} />
                <span class="fx-place__body">
                  <span class="fx-place__t">{d.label}</span>
                  <span class="fx-place__track" aria-hidden="true"><span class="fx-place__fill" style={`width:${percent(d.usedBytes, d.totalBytes)}%`}></span></span>
                  <span class="fx-place__meta">{bytes(d.freeBytes)} libres</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </nav>

      <section class="fx-main" aria-labelledby="fx-title">
        <div class="fx-tb" id="fx-cmdbar" role="toolbar" aria-label="Barre d’outils">
          <div class="fx-seg">
            <button type="button" class="fx-tbtn" data-act="back" title="Précédent (⌘[)" aria-label="Précédent"><Icon name="chevronLeft" size={18} /></button>
            <button type="button" class="fx-tbtn" data-act="forward" title="Suivant (⌘])" aria-label="Suivant"><Icon name="chevronRight" size={18} /></button>
          </div>
          <h2 class="fx-title" id="fx-title">Racine</h2>
          <span class="fx-grow"></span>
          <div class="fx-seg fx-seg--boxed" role="group" aria-label="Présentation">
            <button type="button" class="fx-tbtn" data-act="view-icons" aria-pressed="false" title="Icônes (⌘1)" aria-label="Présentation en icônes"><Icon name="apps" size={16} /></button>
            <button type="button" class="fx-tbtn" data-act="view-list" aria-pressed="true" title="Liste (⌘2)" aria-label="Présentation en liste"><Icon name="list" size={16} /></button>
          </div>
          <button type="button" class="fx-tbtn" data-act="quicklook" title="Coup d’œil (Espace)" aria-label="Coup d’œil" disabled><Icon name="eye" size={18} /></button>
          {admin && <button type="button" class="fx-tbtn" data-act="new" title="Nouveau" aria-label="Nouveau" aria-haspopup="menu"><Icon name="folderPlus" size={18} /></button>}
          {admin && <button type="button" class="fx-tbtn" data-act="upload" title="Téléverser" aria-label="Téléverser"><Icon name="upload" size={18} /></button>}
          <button type="button" class="fx-tbtn" data-act="actions" title="Actions" aria-label="Actions" aria-haspopup="menu"><Icon name="more" size={18} /></button>
          <div class="fx-search" role="search">
            <Icon name="search" size={14} />
            <input type="search" id="fx-filter" placeholder="Rechercher" aria-label="Filtrer ce dossier" autocomplete="off" spellcheck="false" data-search-target />
          </div>
          <input type="file" id="fx-file-input" class="visually-hidden" multiple tabindex="-1" aria-hidden="true" />
        </div>

        <div class="fx-list" id="fx-list" tabindex="0" aria-describedby="fx-hint" aria-labelledby="fx-title">
          <div class="fx-grid" id="fx-grid" role="listbox" aria-label="Contenu du dossier" aria-multiselectable="true" hidden></div>
          <table class="fx-table" id="fx-table" role="grid" aria-label="Contenu du dossier" aria-multiselectable="true">
            <thead>
              <tr>
                <th data-sort="name" aria-sort="ascending"><button type="button" class="fx-th">Nom <span class="fx-arrow" aria-hidden="true"></span></button></th>
                <th data-sort="mtime" aria-sort="none" class="fx-hide-sm"><button type="button" class="fx-th">Date de modification <span class="fx-arrow" aria-hidden="true"></span></button></th>
                <th data-sort="size" aria-sort="none" class="al-right"><button type="button" class="fx-th">Taille <span class="fx-arrow" aria-hidden="true"></span></button></th>
                <th data-sort="type" aria-sort="none" class="fx-hide-md"><button type="button" class="fx-th">Type <span class="fx-arrow" aria-hidden="true"></span></button></th>
                <th class="fx-hide-md">Droits</th>
              </tr>
            </thead>
            <tbody id="fx-tbody"></tbody>
          </table>
          <div id="fx-state" hidden></div>
          <button type="button" id="fx-more" class="fx-more" hidden></button>
          <div id="fx-drop" class="fx-drop" hidden><Icon name="upload" size={20} /><p>Déposer pour téléverser dans ce dossier</p></div>
        </div>
        <p id="fx-hint" class="visually-hidden">Flèches pour naviguer, Espace pour le coup d’œil, Entrée pour ouvrir, taper des lettres pour aller à un nom.</p>

        <div class="fx-pathbar" id="fx-address" title="Cliquer pour saisir un chemin (⌘L)">
          <nav class="fx-crumbs" id="fx-crumbs" aria-label="Chemin"></nav>
          <input type="text" id="fx-addr" class="fx-addr" hidden spellcheck="false" autocomplete="off" aria-label="Chemin du dossier" />
        </div>
        <div class="fx-statusbar">
          <span id="fx-status" aria-live="polite">Chargement…</span>
          <span id="fx-clip" class="fx-clip"></span>
          {!admin && <span class="fx-ro"><Icon name="eye" size={14} />Lecture seule</span>}
        </div>
      </section>
    </div>

    <div class="fx fx-ql" id="fx-ql" hidden>
      <div class="fx-ql__win" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="fx-ql-title">
        <div class="fx-ql__bar">
          <div class="fx-ql__lights">
            <button type="button" class="fx-ql__light fx-ql__light--close" data-ql="close" title="Fermer (Espace ou Échap)" aria-label="Fermer le coup d’œil"><Icon name="dismiss" size={12} /></button>
            <button type="button" class="fx-ql__light fx-ql__light--max" data-ql="max" title="Plein écran" aria-label="Plein écran" aria-pressed="false"><Icon name="maximize" size={12} /></button>
          </div>
          <div class="fx-ql__titles">
            <h2 class="fx-ql__title" id="fx-ql-title"></h2>
            <p class="fx-ql__meta" id="fx-ql-meta"></p>
          </div>
          <div class="fx-ql__actions" id="fx-ql-actions"></div>
        </div>
        <div class="fx-ql__body" id="fx-ql-body"></div>
        <button type="button" class="fx-ql__nav fx-ql__nav--prev" data-ql="prev" aria-label="Fichier précédent" title="Précédent (←)"><Icon name="chevronLeft" size={20} /></button>
        <button type="button" class="fx-ql__nav fx-ql__nav--next" data-ql="next" aria-label="Fichier suivant" title="Suivant (→)"><Icon name="chevronRight" size={20} /></button>
      </div>
    </div>
  </div>
</PanelLayout>

<script>
  import '../scripts/pages/fichiers';
</script>

<style is:global>
  .fx [hidden] { display: none !important; }
  .fx {
    --fx-sel: var(--accent);
    --fx-sel-fg: var(--accent-fg, #fff);
    --fx-soft: color-mix(in srgb, var(--text-primary) 7%, transparent);
    --fx-zebra: color-mix(in srgb, var(--text-primary) 3%, transparent);
    --fx-ring: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  /* Alerte de téléversement */
  .v-alert.fx-upload { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .fx-upload__bar { flex: 0 0 12rem; height: 0.5rem; border-radius: 999px; background: var(--bg-hover); overflow: hidden; }
  .fx-upload__fill { height: 100%; width: 0; background: var(--accent); transition: width 150ms linear; }
  .fx-upload__msg { flex: 1; margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .fx-upload[data-state='ok'] .fx-upload__msg { color: var(--success); }
  .fx-upload[data-state='error'] .fx-upload__msg { color: var(--danger); }
  .fx-upload[data-state='error'] .fx-upload__fill { background: var(--danger); }

  /* Fenêtre */
  .fx-win {
    display: grid; grid-template-columns: 13.5rem minmax(0, 1fr);
    height: max(30rem, calc(100dvh - 13rem));
    border: 1px solid var(--border); border-radius: 0.875rem; overflow: hidden;
    background: var(--bg-surface); box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 8px 24px rgb(0 0 0 / 0.06);
  }

  /* Barre latérale */
  .fx-side { display: flex; flex-direction: column; gap: 0.125rem; padding: 0.75rem 0.5rem; overflow-y: auto; background: color-mix(in srgb, var(--bg-app) 65%, var(--bg-surface)); border-right: 1px solid var(--border); }
  .fx-side__h { margin: 0.75rem 0 0.25rem; padding-inline: 0.625rem; font-size: 0.6875rem; font-weight: 600; color: var(--text-tertiary); }
  .fx-side__h:first-child { margin-top: 0.25rem; }
  .fx-side__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .fx-place { display: flex; align-items: center; gap: 0.5rem; width: 100%; min-height: 1.875rem; padding: 0.25rem 0.625rem; border: 0; border-radius: 0.375rem; background: transparent; color: var(--text-primary); font: 0.8125rem/1.2 var(--font-ui); text-align: left; cursor: default; }
  .fx-place > svg { flex: none; color: var(--accent); }
  .fx-place:hover { background: var(--fx-soft); }
  .fx-place.is-active { background: color-mix(in srgb, var(--text-primary) 11%, transparent); font-weight: 500; }
  .fx-place:focus-visible { outline: none; box-shadow: var(--fx-ring); }
  .fx-place__t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx-place--disk { align-items: flex-start; padding-block: 0.375rem; }
  .fx-place--disk > svg { margin-top: 0.0625rem; color: var(--text-secondary); }
  .fx-place__body { display: flex; flex-direction: column; gap: 0.25rem; flex: 1; min-width: 0; }
  .fx-place__track { height: 0.25rem; border-radius: 999px; background: var(--fx-soft); overflow: hidden; }
  .fx-place__fill { display: block; height: 100%; border-radius: 999px; background: var(--accent); }
  .fx-place__meta { font-size: 0.6875rem; color: var(--text-secondary); }

  /* Zone principale */
  .fx-main { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
  .fx-more { display: block; margin: 0.75rem auto; height: 2rem; padding: 0 0.875rem; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--bg-surface); color: var(--text-primary); font: 500 0.8125rem var(--font-ui); cursor: pointer; }
  .fx-more:hover { background: var(--bg-hover); }
  .fx-more:focus-visible { outline: none; box-shadow: var(--fx-ring); }
  .fx-more[hidden] { display: none; }
  .fx-tb { display: flex; align-items: center; gap: 0.25rem; min-height: 3.25rem; padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
  .fx-title { margin: 0 0.5rem; font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx-grow { flex: 1; }
  .fx-seg { display: inline-flex; align-items: center; }
  .fx-seg--boxed { padding: 2px; border-radius: 0.5rem; background: var(--fx-soft); margin-right: 0.25rem; }
  .fx-tbtn { display: inline-grid; place-items: center; min-width: 2rem; height: 2rem; padding: 0 0.375rem; border: 0; border-radius: 0.4375rem; background: transparent; color: var(--text-secondary); cursor: default; transition: background-color 120ms, color 120ms; }
  .fx-tbtn:hover:not(:disabled) { background: var(--fx-soft); color: var(--text-primary); }
  .fx-tbtn:disabled { opacity: 0.35; }
  .fx-tbtn:focus-visible { outline: none; box-shadow: var(--fx-ring); }
  .fx-seg--boxed .fx-tbtn { height: 1.75rem; min-width: 2.25rem; }
  .fx-seg--boxed .fx-tbtn[aria-pressed='true'] { background: var(--bg-surface); color: var(--text-primary); box-shadow: 0 1px 2px rgb(0 0 0 / 0.12); }
  .fx-search { position: relative; display: flex; align-items: center; flex: 0 1 12rem; min-width: 7rem; margin-left: 0.375rem; }
  .fx-search > svg { position: absolute; left: 0.5rem; color: var(--text-tertiary); pointer-events: none; }
  .fx-search input { width: 100%; height: 1.875rem; padding: 0 0.5rem 0 1.75rem; border: 1px solid transparent; border-radius: 0.4375rem; background: var(--fx-soft); color: var(--text-primary); font: 0.8125rem var(--font-ui); outline: none; }
  .fx-search input:focus { border-color: var(--accent); box-shadow: var(--fx-ring); background: var(--bg-surface); }

  .fx-list { position: relative; flex: 1; min-height: 0; overflow: auto; outline: none; }
  .fx-list:focus-visible { box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 45%, transparent); }
  .fx-list[aria-busy='true'] .fx-item { opacity: 0.6; }

  /* Vue Liste */
  .fx-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.8125rem; padding: 0 0.5rem 0.5rem; }
  .fx-table thead th { position: sticky; top: 0; z-index: 1; padding: 0 0.625rem; height: 1.875rem; text-align: left; font-weight: 500; font-size: 0.75rem; color: var(--text-secondary); background: var(--bg-surface); border-bottom: 1px solid var(--border); white-space: nowrap; }
  .fx-table thead th + th { box-shadow: inset 1px 0 0 0 color-mix(in srgb, var(--border) 70%, transparent); }
  .fx-th { all: unset; box-sizing: border-box; display: inline-flex; align-items: center; gap: 0.25rem; width: 100%; height: 100%; cursor: default; }
  .fx-th:hover { color: var(--text-primary); }
  .fx-th:focus-visible { box-shadow: var(--fx-ring); border-radius: 0.25rem; }
  .fx-table th.al-right .fx-th { justify-content: flex-end; }
  .fx-arrow { display: inline-flex; color: var(--text-secondary); }
  .fx-table td { padding: 0 0.625rem; height: 1.75rem; white-space: nowrap; color: var(--text-secondary); }
  .fx-table td:first-child { color: var(--text-primary); border-radius: 0.375rem 0 0 0.375rem; white-space: normal; }
  .fx-table td:last-child { border-radius: 0 0.375rem 0.375rem 0; }
  .fx-table .al-right { text-align: right; font-variant-numeric: tabular-nums; }
  .fx-table .is-mono { font-family: var(--font-mono); font-size: 0.75rem; }
  .fx-table tbody tr:nth-child(even) td { background: var(--fx-zebra); }
  .fx-table th:first-child, .fx-table td:first-child { width: 55%; min-width: 12rem; }
  .fx-item { cursor: default; user-select: none; -webkit-user-select: none; }
  .fx-table tbody tr.is-selected td { background: var(--fx-sel); color: var(--fx-sel-fg); }
  .fx-table tbody tr.is-selected .fx-ic { color: var(--fx-sel-fg); }
  .fx-list:not(:focus-within) .fx-table tbody tr.is-selected td { background: color-mix(in srgb, var(--text-primary) 13%, transparent); color: var(--text-primary); }
  .fx-list:not(:focus-within) .fx-table tbody tr.is-selected .fx-ic { color: var(--k, var(--text-secondary)); }
  .fx-item.is-cut .fx-name, .fx-item.is-cut .fx-tile__ic { opacity: 0.45; }
  .fx-name { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .fx-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fx-link { color: var(--text-tertiary); font-size: 0.6875rem; }

  /* Icônes par type */
  .fx-k-dir { --k: var(--accent); }
  .fx-k-image { --k: #2f9e6e; }
  .fx-k-video { --k: #8b5cf6; }
  .fx-k-audio { --k: #e5487a; }
  .fx-k-pdf { --k: #e5484d; }
  .fx-k-archive { --k: #b07d3a; }
  .fx-k-code { --k: #d97706; }
  .fx-k-text { --k: var(--text-secondary); }
  .fx-ic { display: inline-flex; flex: none; color: var(--k); }
  .fx-tile__ic .fx-ic svg, .fx-ql-card .fx-ic svg { stroke-width: 1.1; }
  .fx-k-dir .fx-ic svg, .fx-tile.fx-k-dir .fx-tile__ic svg { fill: color-mix(in srgb, var(--accent) 30%, var(--bg-surface)); }

  /* Vue Icônes */
  .fx-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: 0.25rem 0.5rem; padding: 1rem; align-content: start; }
  .fx-tile { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 0.25rem; min-width: 0; border-radius: 0.5rem; outline: none; }
  .fx-tile__ic { display: grid; place-items: center; width: 4.75rem; height: 4.25rem; border-radius: 0.375rem; color: var(--k); }
  .fx-tile__ic img { max-width: 4.25rem; max-height: 3.75rem; object-fit: contain; border-radius: 2px; box-shadow: 0 1px 3px rgb(0 0 0 / 0.2); background: repeating-conic-gradient(var(--fx-soft) 0 25%, transparent 0 50%) 0 0 / 10px 10px; }
  .fx-tile__n { max-width: 100%; padding: 0.0625rem 0.375rem; border-radius: 0.25rem; font-size: 0.75rem; line-height: 1.3; text-align: center; color: var(--text-primary); overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .fx-tile.is-selected .fx-tile__ic { background: var(--fx-soft); }
  .fx-tile.is-selected .fx-tile__n { background: var(--fx-sel); color: var(--fx-sel-fg); -webkit-line-clamp: unset; }
  .fx-list:not(:focus-within) .fx-tile.is-selected .fx-tile__n { background: color-mix(in srgb, var(--text-primary) 13%, transparent); color: var(--text-primary); }
  .fx-doc { position: relative; display: flex; align-items: flex-end; justify-content: center; width: 2.875rem; height: 3.625rem; padding-bottom: 0.375rem; border: 1px solid var(--border); border-radius: 0.1875rem 0.75rem 0.1875rem 0.1875rem; background: var(--bg-surface); box-shadow: 0 1px 2px rgb(0 0 0 / 0.1); }
  .fx-doc > svg { position: absolute; top: 0.625rem; left: 50%; translate: -50% 0; }
  .fx-doc__x { max-width: 92%; overflow: hidden; font: 700 0.5625rem/1 var(--font-ui); letter-spacing: 0.04em; text-transform: uppercase; color: var(--k); }

  /* Renommage, création */
  .fx-edit { height: 1.5rem; width: 16rem; max-width: 100%; padding: 0 0.375rem; border: 1px solid var(--accent); border-radius: 0.25rem; background: var(--bg-surface); color: var(--text-primary); font: 0.8125rem var(--font-ui); box-shadow: var(--fx-ring); outline: none; }
  .fx-tile .fx-edit { width: 100%; text-align: center; font-size: 0.75rem; }

  /* Glisser-déposer */
  .fx-item.is-over td, .fx-item.is-over .fx-tile__ic, .fx-place.is-over, .fx-crumb.is-over { background: color-mix(in srgb, var(--accent) 18%, transparent); box-shadow: inset 0 0 0 2px var(--accent); }
  .fx-drop { position: absolute; inset: 0.5rem; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; color: var(--accent-text); background: color-mix(in srgb, var(--bg-surface) 88%, transparent); border: 2px dashed var(--accent); border-radius: 0.625rem; pointer-events: none; }

  /* Barre de chemin et barre d'état */
  .fx-pathbar { display: flex; align-items: center; min-height: 1.75rem; padding: 0 0.5rem; border-top: 1px solid var(--border); cursor: text; }
  .fx-crumbs { display: flex; align-items: center; gap: 0.125rem; width: 100%; overflow-x: auto; scrollbar-width: none; white-space: nowrap; }
  .fx-crumb { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.0625rem 0.3125rem; border-radius: 0.25rem; color: var(--text-secondary); text-decoration: none; font-size: 0.75rem; cursor: default; }
  .fx-crumb > svg { color: var(--accent); }
  .fx-crumb:hover { background: var(--fx-soft); color: var(--text-primary); }
  .fx-crumb:focus-visible { outline: none; box-shadow: var(--fx-ring); }
  .fx-crumb[aria-current] { color: var(--text-primary); font-weight: 500; }
  .fx-sep { display: inline-flex; color: var(--text-tertiary); }
  .fx-addr { width: 100%; height: 1.5rem; border: 1px solid var(--accent); border-radius: 0.25rem; background: var(--bg-surface); color: var(--text-primary); font: 0.75rem var(--font-mono); padding-inline: 0.5rem; outline: none; box-shadow: var(--fx-ring); }
