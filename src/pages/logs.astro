---
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/vault.css';
import * as logs from '../server/system/logs.js';
import { safe } from '../server/core/safe';

export const prerender = false;

const sources = await safe(() => logs.listLogSources(), [] as any[]);
const url = Astro.url;
const requested = url.searchParams.get('source');
const current = sources.some((s: any) => s.id === requested) ? requested : (sources[0]?.id ?? null);

if (url.searchParams.get('format') === 'json') {
  const headers = { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' };
  if (!current) return new Response(JSON.stringify({ error: 'Aucune source de journal' }), { status: 404, headers });
  const n = Math.min(Math.max(parseInt(url.searchParams.get('lines') ?? '300', 10) || 300, 1), 2000);
  try {
    const text = await logs.readLog(current, n);
    const lines = String(text ?? '').split('\n').filter((l) => l !== '');
    return new Response(JSON.stringify({ source: current, lines, at: Date.now() }), { headers });
  } catch (e: any) {
    return new Response(JSON.stringify({ error: e?.message ?? 'Lecture impossible' }), { status: 500, headers });
  }
}

/** Recomposé avec les blocs du Vault (dashboardblocks, MIT) : dashboard-header-01 (barre de filtres), notifications-03 (filtres par niveau), activity-feed-01 (fil), status-label, alerts-01. */
const LEVELS = [['all', 'Tous'], ['error', 'Erreurs'], ['warn', 'Avertissements'], ['info', 'Infos'], ['debug', 'Debug']] as const;
const srcLabel = (l: string) => String(l ?? '').replace(/\s*\(journald\)/i, '');
---
<PanelLayout title="Journaux" refreshMs={null}>
  <div class="v-page v-page--wide">
  {sources.length === 0 ? (
    <section class="v-card">
      <div class="v-empty">
        <Icon name="logs" size={24} />
        <p class="v-empty__title">Aucune source de journal disponible</p>
        <p class="v-empty__text">Le panel ne trouve aucun journal à lire sur cette machine.</p>
      </div>
    </section>
  ) : (
    <section class="v-card" id="lg-root" data-source={current}>
      <header class="v-card__head">
        <div class="v-card__titles">
          <h2 class="v-card__title">Journal</h2>
          <p class="v-card__desc">Dernières lignes de la source choisie, relues toutes les 3 secondes tant que le direct est actif.</p>
        </div>
        <span class="v-status v-status--good" id="lg-live-state">En direct</span>
      </header>

      <div class="v-toolbar" role="group" aria-label="Options du journal">
        <label class="lg-search">
          <Icon name="search" size={16} />
          <input class="v-input" type="search" id="lg-search" placeholder="Rechercher dans le journal" aria-label="Rechercher dans le journal" autocomplete="off" spellcheck="false" data-search-target />
        </label>
        <select class="v-select" id="lg-source" aria-label="Source du journal">
          {sources.map((s: any) => <option value={s.id} selected={s.id === current}>{srcLabel(s.label)}</option>)}
        </select>
        <select class="v-select" id="lg-lines" aria-label="Nombre de lignes">
          <option value="100">100 lignes</option>
          <option value="300" selected>300 lignes</option>
          <option value="1000">1 000 lignes</option>
          <option value="2000">2 000 lignes</option>
        </select>
        <div class="lg-actions">
          <button type="button" class="v-btn v-btn--outline" id="lg-live" aria-pressed="true"><Icon name="pause" size={16} />Pause</button>
          <button type="button" class="v-btn v-btn--outline v-btn--icon" id="lg-refresh" aria-label="Actualiser maintenant" title="Actualiser maintenant"><Icon name="refresh" size={16} /></button>
          <button type="button" class="v-btn v-btn--outline" id="lg-follow" aria-pressed="true"><Icon name="arrowDown" size={16} />Suivre</button>
          <button type="button" class="v-btn v-btn--outline v-btn--icon" id="lg-download" aria-label="Télécharger les lignes affichées" title="Télécharger les lignes affichées"><Icon name="download" size={16} /></button>
        </div>
      </div>

      <div class="lg-levels">
        <div class="v-tabs" role="group" aria-label="Niveau">
          {LEVELS.map(([v, label]) => (
            <button type="button" class="v-tab" data-lv={v} aria-pressed={v === 'all'}>{label}{(v === 'error' || v === 'warn') && <span class="v-tag" data-n={v}>0</span>}</button>
          ))}
        </div>
        <select id="lg-level" aria-label="Niveau" hidden>
          <option value="all">Tous les niveaux</option>
          <option value="error">Erreurs</option>
          <option value="warn">Avertissements</option>
          <option value="info">Infos</option>
          <option value="debug">Debug</option>
        </select>
      </div>

      <p id="lg-stale" class="v-alert v-alert--warn lg-stale" role="status" hidden>Données non actualisées : la dernière lecture a échoué. Les lignes affichées datent de la lecture précédente.</p>
      <div id="lg-viewer" class="viewer" tabindex="0" role="log" aria-label="Contenu du journal" aria-live="off">
        <p class="lg-msg">Chargement…</p>
      </div>
      <footer class="v-card__foot"><span id="lg-stat" class="lg-stat"></span></footer>
    </section>
  )}
  </div>
</PanelLayout>

<script>
  import { toast } from '../scripts/ui/dialog';
  import { registerCommands } from '../scripts/ui/commands';
  import { esc, iconSVG } from '../scripts/ui/html';
  import { highlightLine } from '../scripts/pages/logs';

  type Level = 'error' | 'warn' | 'info' | 'debug' | 'ok' | 'none';
  const POLL_MS = 3000;
  const PREF = 'logs-live';

  function levelOf(l: string): Level {
    if (/\b(FATAL|CRITICAL|SEVERE|ERROR|ERR|Exception|Traceback|failed|failure|panic)\b/i.test(l)) return 'error';
    if (/\b(WARN|WARNING)\b|Can't keep up/i.test(l)) return 'warn';
    if (/\bDone \(/.test(l)) return 'ok';
    if (/\b(INFO)\b/.test(l)) return 'info';
    if (/\b(DEBUG|TRACE)\b/i.test(l)) return 'debug';
    return 'none';
  }
  const TAG: Record<string, string> = { error: 'Erreur : ', warn: 'Avertissement : ' };

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('lg-root');
    if (!root) return;
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const sourceSel = $<HTMLSelectElement>('lg-source'), levelSel = $<HTMLSelectElement>('lg-level'), linesSel = $<HTMLSelectElement>('lg-lines');
    const search = $<HTMLInputElement>('lg-search'), viewer = $('lg-viewer'), stat = $('lg-stat'), stale = $('lg-stale');
    const liveBtn = $<HTMLButtonElement>('lg-live'), followBtn = $<HTMLButtonElement>('lg-follow'), liveState = $('lg-live-state');
    const lvTabs = [...root.querySelectorAll<HTMLButtonElement>('[data-lv]')];

    let all: { text: string; level: Level }[] = [];
    let live = true;
    try { live = localStorage.getItem(PREF) !== 'off'; } catch {}
    let follow = true;
    let shown: string[] = [];
    let timer: number | undefined;
    let busy = false;
    let failed = false;
    let painted = '';

    const setBtn = (b: HTMLElement, icon: 'play' | 'pause' | 'arrowDown', text: string, on: boolean) => {
      b.innerHTML = `${iconSVG(icon, 16)}${esc(text)}`;
      b.setAttribute('aria-pressed', String(on));
    };
    const paintButtons = () => {
      setBtn(liveBtn, live ? 'pause' : 'play', live ? 'Pause' : 'Reprendre', live);
      liveState.textContent = live ? 'En direct' : 'En pause';
      liveState.className = `v-status v-status--${live ? 'good' : 'warning'}`;
      liveBtn.title = live ? 'Mise à jour en direct active : mettre en pause' : 'En pause : reprendre le direct';
      setBtn(followBtn, 'arrowDown', 'Suivre', follow);
      followBtn.title = 'Suivre les nouvelles lignes';
    };

    const toBottom = () => { viewer.scrollTop = viewer.scrollHeight; };

    function render(force = true) {
      const q = search.value.trim().toLowerCase();
      const lv = levelSel.value;
      const keep = all.filter((l) => (lv === 'all' || l.level === lv) && (!q || l.text.toLowerCase().includes(q)));
      shown = keep.map((l) => l.text);
      const counts = { error: 0, warn: 0 };
      for (const l of all) if (l.level === 'error' || l.level === 'warn') counts[l.level]++;
      for (const t of lvTabs) {
        t.setAttribute('aria-pressed', String(t.dataset.lv === lv));
        const n = t.querySelector('[data-n]');
        if (n) n.textContent = String(counts[t.dataset.lv as 'error' | 'warn']);
      }
      stat.textContent = `${keep.length} sur ${all.length} lignes · ${counts.error} erreurs · ${counts.warn} avertissements`;

      if (failed) return;
      // Repeindre seulement si le contenu change, et jamais pendant une sélection de texte (le polling l'effacerait).
      const sig = `${lv}|${q}|${keep.length}|${keep.map((l) => l.text).join('\n')}`;
      if (!force) {
        if (sig === painted) return;
        const sel = getSelection();
        if (sel && !sel.isCollapsed && viewer.contains(sel.anchorNode)) return;
      }
      painted = sig;
      if (!keep.length) {
        viewer.innerHTML = `<p class="lg-msg">${all.length ? 'Aucune ligne ne correspond aux filtres.' : 'Aucune ligne à afficher.'}</p>`;
        return;
      }
      viewer.innerHTML = keep.map((l) => {
        const body = highlightLine(l.text, q);
        const tag = TAG[l.level] ? `<span class="visually-hidden">${TAG[l.level]}</span>` : '';
        return `<div class="line l-${l.level}">${tag}${body}</div>`;
      }).join('');
      if (follow) toBottom();
    }

    async function load(manual = false) {
      if (busy) return;
      busy = true;
      try {
        const res = await fetch(`/logs?format=json&source=${encodeURIComponent(sourceSel.value)}&lines=${linesSel.value}`, { headers: { accept: 'application/json' } });
        const out = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(out.error || `Erreur ${res.status}`);
        failed = false;
        stale.hidden = true;
        all = (out.lines as string[]).map((text) => ({ text, level: levelOf(text) }));
        render(manual);
        if (manual) toast('Journal actualisé.', 'success', 1500);
      } catch (e: any) {
        if (all.length) { stale.hidden = false; return; }
        failed = true;
        painted = '';
        viewer.innerHTML = `<div class="v-empty" role="alert"><span class="lg-err-icon">${iconSVG('circleAlert', 20)}</span>`
          + `<p class="v-empty__title">Impossible de lire ce journal</p>`
          + `<p class="v-empty__text">Réessayez ou choisissez une autre source.</p><pre class="v-code">${esc(e?.message ?? e)}</pre></div>`;
      } finally { busy = false; }
    }

    function schedule() {
      clearInterval(timer);
      if (live) timer = window.setInterval(() => { if (document.visibilityState === 'visible') load(); }, POLL_MS);
    }
    const setLive = (v: boolean) => {
      live = v;
      try { localStorage.setItem(PREF, v ? 'on' : 'off'); } catch {}
      paintButtons(); schedule();
      if (v) load();
    };
    const setFollow = (v: boolean) => { follow = v; paintButtons(); if (v) toBottom(); };

    sourceSel.addEventListener('change', () => {
      const u = new URL(location.href); u.searchParams.set('source', sourceSel.value);
      history.replaceState(history.state, '', u);
      viewer.innerHTML = '<p class="lg-msg">Chargement…</p>';
      all = []; painted = ''; stale.hidden = true;
      load();
    });
    linesSel.addEventListener('change', () => load());
    levelSel.addEventListener('change', () => render());
    for (const t of lvTabs) t.addEventListener('click', () => { levelSel.value = t.dataset.lv!; render(); });
    search.addEventListener('input', () => render());
    liveBtn.addEventListener('click', () => setLive(!live));
    followBtn.addEventListener('click', () => setFollow(!follow));
    $('lg-refresh').addEventListener('click', () => load(true));
    $('lg-download').addEventListener('click', () => {
      if (!shown.length) { toast('Rien à télécharger.', 'warning'); return; }
      const blob = new Blob([shown.join('\n') + '\n'], { type: 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `orvane-${sourceSel.value}-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}.log`;
      document.body.append(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    viewer.addEventListener('scroll', () => {
      const atBottom = viewer.scrollHeight - viewer.scrollTop - viewer.clientHeight < 24;
      if (atBottom !== follow) { follow = atBottom; paintButtons(); }
    }, { passive: true });

    paintButtons(); schedule(); load();
    document.addEventListener('astro:before-swap', () => clearInterval(timer), { once: true });

    const lvlCmd = (title: string, v: string) => ({ id: `logs-lvl-${v}`, title, icon: 'filter' as const, run: () => { levelSel.value = v; render(); } });
    registerCommands([
      { id: 'logs-live', title: 'Journaux : pause / reprise du direct', icon: 'pause', run: () => setLive(!live) },
      { id: 'logs-refresh', title: 'Journaux : actualiser', icon: 'refresh', run: () => load(true) },
      { id: 'logs-download', title: 'Journaux : télécharger les lignes affichées', icon: 'download', run: () => $('lg-download').click() },
      lvlCmd('Journaux : erreurs seulement', 'error'),
      lvlCmd('Journaux : avertissements seulement', 'warn'),
      lvlCmd('Journaux : tous les niveaux', 'all'),
    ]);
  });
</script>

<style>
  .lg-search { position: relative; display: flex; align-items: center; flex: 1 1 14rem; min-width: 0; }
  .lg-search > :global(svg) { position: absolute; left: 0.75rem; width: 1rem; height: 1rem; color: var(--text-tertiary); pointer-events: none; }
  .lg-search :global(.v-input) { width: 100%; padding-left: 2.25rem; }
  .lg-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-left: auto; }
  .lg-actions :global(.v-btn--icon) { width: 2.25rem; }
  .lg-actions :global(.v-btn[aria-pressed='true']) { border-color: var(--accent-border); background: var(--accent-subtle); color: var(--accent-text); }
  .lg-levels { display: flex; }
  .lg-stale { margin-inline: 1.5rem; }
  .lg-stale[hidden], #lg-level[hidden] { display: none; }
  .lg-stat { font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) { .lg-actions { margin-left: 0; width: 100%; } .lg-stale { margin-inline: 1rem; } }

  .viewer {
    background: var(--console-bg); color: var(--console-fg);
    height: min(65vh, 40rem); overflow: auto;
    padding: 0.75rem 0;
    border: 1px solid var(--console-border); border-radius: 0.625rem;
    font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.5rem;
  }
  .viewer:focus-visible { outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }
  .viewer ::selection { background: var(--console-select); color: var(--console-strong); }
  .viewer :global(.line) { white-space: pre; color: var(--console-fg); padding: 0 1rem; border-left: 3px solid transparent; }
  .viewer :global(.line:hover) { background: rgb(255 255 255 / 0.04); }
  @media (max-width: 640px) { .viewer :global(.line) { white-space: pre-wrap; overflow-wrap: anywhere; } }
  .viewer :global(.l-error) { color: var(--console-red); border-left-color: var(--console-red); background: color-mix(in srgb, var(--console-red) 8%, transparent); }
  .viewer :global(.l-warn) { color: var(--console-yellow); border-left-color: var(--console-yellow); }
  .viewer :global(.l-ok) { color: var(--console-green); }
  .viewer :global(.l-debug) { color: var(--console-muted); }
  .viewer :global(mark) { background: var(--console-select); color: var(--console-strong); border-radius: 0.125rem; }
  .viewer :global(.lg-msg) { margin: 0; padding: 0 1rem; color: var(--console-muted); font-family: var(--font-ui); font-size: 0.875rem; }
  .viewer :global(.v-empty__title), .viewer :global(.v-empty__text) { color: var(--console-fg); }
  .viewer :global(.lg-err-icon) { color: var(--console-red); display: inline-flex; }
  .viewer :global(.v-code) { max-width: 100%; background: transparent; border-color: var(--console-border); color: var(--console-fg); }
</style>
