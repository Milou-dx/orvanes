---
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/vault.css';
import * as logs from '../server/system/logs.js';
import { safe } from '../server/core/safe';

export const prerender = false;

const sources = await safe(() => logs.listLogSources(), [] as any[]);
const url = Astro.url;
const requested = url.searchParams.get('source');
const current = sources.some((s: any) => s.id === requested) ? requested : (sources[0]?.id ?? null);

if (url.searchParams.get('format') === 'json') {
  const headers = { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' };
  if (!current) return new Response(JSON.stringify({ error: 'Aucune source de journal' }), { status: 404, headers });
  const n = Math.min(Math.max(parseInt(url.searchParams.get('lines') ?? '300', 10) || 300, 1), 2000);
  try {
    const text = await logs.readLog(current, n);
    const lines = String(text ?? '').split('\n').filter((l) => l !== '');
    return new Response(JSON.stringify({ source: current, lines, at: Date.now() }), { headers });
  } catch (e: any) {
    return new Response(JSON.stringify({ error: e?.message ?? 'Lecture impossible' }), { status: 500, headers });
  }
}

/** Recomposé avec les blocs du Vault (dashboardblocks, MIT) : dashboard-header-01 (barre de filtres), notifications-03 (filtres par niveau), activity-feed-01 (fil), status-label, alerts-01. */
const LEVELS = [['all', 'Tous'], ['error', 'Erreurs'], ['warn', 'Avertissements'], ['info', 'Infos'], ['debug', 'Debug']] as const;
const srcLabel = (l: string) => String(l ?? '').replace(/\s*\(journald\)/i, '');
---
<PanelLayout title="Journaux" refreshMs={null}>
  <div class="v-page v-page--wide">
  {sources.length === 0 ? (
    <section class="v-card">
      <div class="v-empty">
        <Icon name="logs" size={24} />
        <p class="v-empty__title">Aucune source de journal disponible</p>
        <p class="v-empty__text">Le panel ne trouve aucun journal à lire sur cette machine.</p>
      </div>
    </section>
  ) : (
    <section class="v-card" id="lg-root" data-source={current}>
      <header class="v-card__head">
        <div class="v-card__titles">
          <h2 class="v-card__title">Journal</h2>
          <p class="v-card__desc">Dernières lignes de la source choisie, relues toutes les 3 secondes tant que le direct est actif.</p>
        </div>
        <span class="v-status v-status--good" id="lg-live-state">En direct</span>
      </header>

      <div class="v-toolbar" role="group" aria-label="Options du journal">
        <label class="lg-search">
          <Icon name="search" size={16} />
          <input class="v-input" type="search" id="lg-search" placeholder="Rechercher dans le journal" aria-label="Rechercher dans le journal" autocomplete="off" spellcheck="false" data-search-target />
        </label>
        <select class="v-select" id="lg-source" aria-label="Source du journal">
          {sources.map((s: any) => <option value={s.id} selected={s.id === current}>{srcLabel(s.label)}</option>)}
        </select>
        <select class="v-select" id="lg-lines" aria-label="Nombre de lignes">
          <option value="100">100 lignes</option>
          <option value="300" selected>300 lignes</option>
          <option value="1000">1 000 lignes</option>
          <option value="2000">2 000 lignes</option>
        </select>
        <div class="lg-actions">
          <button type="button" class="v-btn v-btn--outline" id="lg-live" aria-pressed="true"><Icon name="pause" size={16} />Pause</button>
          <button type="button" class="v-btn v-btn--outline v-btn--icon" id="lg-refresh" aria-label="Actualiser maintenant" title="Actualiser maintenant"><Icon name="refresh" size={16} /></button>
          <button type="button" class="v-btn v-btn--outline" id="lg-follow" aria-pressed="true"><Icon name="arrowDown" size={16} />Suivre</button>
          <button type="button" class="v-btn v-btn--outline v-btn--icon" id="lg-download" aria-label="Télécharger les lignes affichées" title="Télécharger les lignes affichées"><Icon name="download" size={16} /></button>
        </div>
      </div>

      <div class="lg-levels">
        <div class="v-tabs" role="group" aria-label="Niveau">
          {LEVELS.map(([v, label]) => (
            <button type="button" class="v-tab" data-lv={v} aria-pressed={v === 'all'}>{label}{(v === 'error' || v === 'warn') && <span class="v-tag" data-n={v}>0</span>}</button>
          ))}
        </div>
        <select id="lg-level" aria-label="Niveau" hidden>
          <option value="all">Tous les niveaux</option>
          <option value="error">Erreurs</option>
          <option value="warn">Avertissements</option>
          <option value="info">Infos</option>
          <option value="debug">Debug</option>
        </select>
      </div>

      <p id="lg-stale" class="v-alert v-alert--warn lg-stale" role="status" hidden>Données non actualisées : la dernière lecture a échoué. Les lignes affichées datent de la lecture précédente.</p>
      <div id="lg-viewer" class="viewer" tabindex="0" role="log" aria-label="Contenu du journal" aria-live="off">
        <p class="lg-msg">Chargement…</p>
      </div>
      <footer class="v-card__foot"><span id="lg-stat" class="lg-stat"></span></footer>
    </section>
  )}
  </div>
</PanelLayout>

<script>
  import '../scripts/pages/logs-view';
</script>

<style>
  .lg-search { position: relative; display: flex; align-items: center; flex: 1 1 14rem; min-width: 0; }
  .lg-search > :global(svg) { position: absolute; left: 0.75rem; width: 1rem; height: 1rem; color: var(--text-tertiary); pointer-events: none; }
  .lg-search :global(.v-input) { width: 100%; padding-left: 2.25rem; }
  .lg-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-left: auto; }
  .lg-actions :global(.v-btn--icon) { width: 2.25rem; }
  .lg-actions :global(.v-btn[aria-pressed='true']) { border-color: var(--accent-border); background: var(--accent-subtle); color: var(--accent-text); }
  .lg-levels { display: flex; }
  .lg-stale { margin-inline: 1.5rem; }
  .lg-stale[hidden], #lg-level[hidden] { display: none; }
  .lg-stat { font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) { .lg-actions { margin-left: 0; width: 100%; } .lg-stale { margin-inline: 1rem; } }

  .viewer {
    background: var(--console-bg); color: var(--console-fg);
    height: min(65vh, 40rem); overflow: auto;
    padding: 0.75rem 0;
    border: 1px solid var(--console-border); border-radius: 0.625rem;
    font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.5rem;
  }
  .viewer:focus-visible { outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }
  .viewer ::selection { background: var(--console-select); color: var(--console-strong); }
  .viewer :global(.line) { white-space: pre; color: var(--console-fg); padding: 0 1rem; border-left: 3px solid transparent; }
  .viewer :global(.line:hover) { background: rgb(255 255 255 / 0.04); }
  @media (max-width: 640px) { .viewer :global(.line) { white-space: pre-wrap; overflow-wrap: anywhere; } }
  .viewer :global(.l-error) { color: var(--console-red); border-left-color: var(--console-red); background: color-mix(in srgb, var(--console-red) 8%, transparent); }
  .viewer :global(.l-warn) { color: var(--console-yellow); border-left-color: var(--console-yellow); }
  .viewer :global(.l-ok) { color: var(--console-green); }
  .viewer :global(.l-debug) { color: var(--console-muted); }
  .viewer :global(mark) { background: var(--console-select); color: var(--console-strong); border-radius: 0.125rem; }
  .viewer :global(.lg-msg) { margin: 0; padding: 0 1rem; color: var(--console-muted); font-family: var(--font-ui); font-size: 0.875rem; }
  .viewer :global(.v-empty__title), .viewer :global(.v-empty__text) { color: var(--console-fg); }
  .viewer :global(.lg-err-icon) { color: var(--console-red); display: inline-flex; }
  .viewer :global(.v-code) { max-width: 100%; background: transparent; border-color: var(--console-border); color: var(--console-fg); }
</style>
