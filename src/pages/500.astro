---
import AuthLayout from '../layouts/AuthLayout.astro';
import Button from '../components/ui/Button.astro';

export const prerender = false;
interface Props { error?: unknown }
const { error } = Astro.props;
console.error('[500]', Astro.url.pathname, error);
Astro.response.status = 500;
---
<AuthLayout title="Erreur">
  <h1 class="auth__title">Erreur du panel</h1>
  <p class="auth__lead">Le panel n’a pas pu afficher cette page. Réessayez dans quelques secondes : une mise à jour peut faire redémarrer le panel.</p>
  <div class="err__actions">
    <Button variant="primary" id="err-retry">Réessayer</Button>
    <Button variant="secondary" href="/">Retour à l’accueil</Button>
  </div>
</AuthLayout>

<script>
  document.getElementById('err-retry')?.addEventListener('click', () => location.reload());
</script>

<style>
  .err__actions { display: flex; gap: var(--space-2); justify-content: center; flex-wrap: wrap; }
</style>
