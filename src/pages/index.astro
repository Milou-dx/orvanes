---
/**
 * Vue d'ensemble, composée d'après le tableau de bord DevOps du Vault (dashboardblocks
 * dashboard-05, MIT, github.com/LGLabGreg/dashboardblocks) : bandeau d'alertes (alerts-04),
 * rangée de métriques (stat-group-01), courbe temps réel (realtime-02), état des services
 * (status-01) et stockage (usage-meter-05). Réécrit en Astro avec les tokens du panel.
 */
import PanelLayout from '../layouts/PanelLayout.astro';
import Card from '../components/ui/Card.astro';
import Meter from '../components/ui/Meter.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import ErrorState from '../components/ui/ErrorState.astro';
import { bytes, duration, percent, num } from '../server/core/format';
import { safe } from '../server/core/safe';
import { cpus } from 'node:os';

import * as sys from '../server/system/system.js';
import * as svc from '../server/system/services.js';
import { getModule, isInstalled } from '../server/modules/registry.js';
import { tabAllowed } from '../layouts/nav';

export const prerender = false;

const lente = <T,>(fn: () => T | Promise<T>, repli: T, ms = 3000): Promise<T> =>
  Promise.race([safe(fn, repli), new Promise<T>((r) => setTimeout(() => r(repli), ms))]);

const [os, mem, disks, load, up, cpuPct, net, services] = await Promise.all([
  safe(() => sys.getOsInfo(), null),
  safe(() => sys.getMemory(), null),
  safe(() => sys.getDisks(), [] as any[]),
  safe(() => sys.getLoadAverage(), null),
  safe(() => sys.getUptimeSeconds(), null),
  safe(() => sys.getCpuPercent(), null),
  safe(() => sys.getNetTraffic(), { rates: {} } as any),
  lente(() => svc.listServices(), null as any[] | null),
]);

const cores = cpus().length || 1;
const load1 = load?.[0] ?? null;
const cpuShown = cpuPct != null ? Math.round(cpuPct) : load1 !== null ? Math.min(100, Math.round((load1 / cores) * 100)) : 0;
const memPct = mem ? percent(mem.usedBytes, mem.totalBytes) : 0;
const root = disks.find((d: any) => d.path === '/') ?? disks[0];
const diskPct = root ? percent(root.usedBytes, root.totalBytes) : 0;
const rates = Object.values((net?.rates ?? {}) as Record<string, { rxBytesPerSec: number; txBytesPerSec: number }>);
const rx = rates.reduce((a, r) => a + r.rxBytesPerSec, 0);
const tx = rates.reduce((a, r) => a + r.txBytesPerSec, 0);

const KNOWN: [string, string, string][] = [
  ['ssh', 'SSH', 'Accès à distance'], ['caddy', 'Caddy', 'Serveur web et HTTPS'], ['nginx', 'nginx', 'Serveur web'],
  ['postgresql', 'PostgreSQL', 'Base de données'], ['mariadb', 'MariaDB', 'Base de données'], ['docker', 'Docker', 'Conteneurs'],
  ['tailscaled', 'Tailscale', 'Réseau privé'], ['cron', 'Cron', 'Tâches planifiées'], ['fail2ban', 'fail2ban', 'Blocage des intrusions'],
];
const byName = new Map<string, any>((services ?? []).map((s: any) => [s.name, s]));
const failed = (services ?? []).filter((s: any) => s.active === 'failed' && !KNOWN.some(([n]) => n === s.name));
const svcRows = [
  ...failed.map((s: any) => ({ name: s.name as string, what: `${s.name}.service`, state: 'failed' })),
  ...KNOWN.filter(([n]) => byName.has(n)).map(([n, label, what]) => ({ name: label, what, state: byName.get(n).active as string })),
].slice(0, 7);
const STATE_LABEL: Record<string, string> = { active: 'Actif', failed: 'En échec', activating: 'Démarrage' };

// État global (status-01 + alerts-04) : le pire signal décide, une phrase nomme chaque problème.
const liste = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} et ${xs.at(-1)}`);
const down = svcRows.filter((s) => s.state === 'failed').map((s) => `${s.name} en échec`);
const high = [
  cpuShown >= 90 && `processeur à ${cpuShown} %`,
  memPct >= 90 && `mémoire à ${memPct} %`,
  ...disks.filter((d: any) => percent(d.usedBytes, d.totalBytes) >= 90).map((d: any) => `disque ${d.path} à ${percent(d.usedBytes, d.totalBytes)} %`),
].filter(Boolean) as string[];
const level = down.length ? 'error' : high.length ? 'warning' : services === null ? 'unknown' : 'running';
const HEADLINE = { error: 'Incident en cours', warning: 'À surveiller', unknown: 'État partiel', running: 'Tout fonctionne' } as const;
const sentence = level === 'unknown'
  ? 'La liste des services n’a pas répondu à temps. Les ressources s’affichent quand même.'
  : down.length || high.length
    ? `${liste([...down, ...high]).replace(/^./, (c) => c.toUpperCase())}.`
    : `${svcRows.length ? `${svcRows.length} services suivis actifs, r` : 'R'}essources sous 90 %.`;
const alertHref = down.length ? '/services' : high.length ? '/performance' : null;

const can = tabAllowed(Astro.locals);
const HOME = import.meta.glob<{ default: any }>('/modules/*/home.astro', { eager: true });
const moduleCards = Object.entries(HOME)
  .map(([path, mod]) => ({ id: path.split('/')[2]!, Comp: mod.default }))
  .filter(({ id }) => isInstalled(id) && can(getModule(id)?.tabs[0]?.id ?? id))
  .sort((a, b) => (a.id === 'minecraft' ? -1 : b.id === 'minecraft' ? 1 : a.id.localeCompare(b.id)));
const [first, ...rest] = moduleCards;
const First = first?.Comp;

const pct = (p: number) => Math.max(0, Math.min(100, p));
const tone = (p: number) => (p >= 90 ? 'danger' : p >= 70 ? 'warning' : 'ok');
const metrics = [
  { label: 'Processeur', value: `${cpuShown}`, unit: '%', note: `charge ${load1 !== null ? num(load1, 2) : '-'} sur ${cores} cœurs`, p: cpuShown, c: 'var(--res-cpu)' },
  { label: 'Mémoire', value: mem ? bytes(mem.usedBytes) : '-', unit: '', note: mem ? `sur ${bytes(mem.totalBytes)}, ${memPct} %` : 'indisponible', p: memPct, c: 'var(--res-mem)' },
  { label: 'Disque', value: root ? bytes(root.usedBytes) : '-', unit: '', note: root ? `sur ${bytes(root.totalBytes)}, ${bytes(root.freeBytes)} libres` : 'indisponible', p: diskPct, c: 'var(--res-disk)' },
  { label: 'Réseau', value: rates.length ? bytes(rx) : '-', unit: '/s', note: rates.length ? `reçus · ${bytes(tx)}/s émis` : 'indisponible', p: null, c: 'var(--res-net)' },
];
const freest = [...disks].sort((a: any, b: any) => b.freeBytes - a.freeBytes)[0];
const sub = os?.hostname ? [os.hostname, os.osName, `${cores} cœurs`, up ? `en ligne depuis ${duration(up)}` : null].filter(Boolean).join(' · ') : undefined;
---
<PanelLayout title="Vue d’ensemble" subtitle={sub} refreshMs={5000}>
  <div id="home" data-cpu={cpuShown}>
    <section class:list={['strip', `strip--${level}`]} aria-live="polite">
      <p class="strip__head"><span class="strip__dot" aria-hidden="true"></span>{HEADLINE[level]}</p>
      <p class="strip__text">{sentence}</p>
      {alertHref && can(alertHref.slice(1)) && <a class="strip__go" href={alertHref} data-astro-prefetch="hover">Voir ›</a>}
    </section>

    <Card class="stats">
      <ul class="kpis">
        {metrics.map((m) => (
          <li class="kpi" style={`--c:${m.c}`}>
            <p class="kpi__label">{m.label}</p>
            <p class="kpi__value">{m.value}{m.unit && <span class="kpi__unit">{m.unit}</span>}</p>
            <p class="kpi__note">{m.note}</p>
            {m.p !== null
              ? <div class:list={['kpi__bar', `kpi__bar--${tone(m.p)}`]} style={`--p:${pct(m.p)}%`} aria-hidden="true"><span></span></div>
              : <div class="kpi__bar kpi__bar--none" aria-hidden="true"></div>}
          </li>
        ))}
      </ul>
    </Card>

    <div class="g2">
      <Card title="Processeur en direct" description="Relevé toutes les 5 secondes pendant que la page est ouverte.">
        {can('performance') && <a slot="actions" class="more" href="/performance" data-astro-prefetch="hover">Performances ›</a>}
        <p class="now"><span>{cpuShown}</span> %<span class="now__l">maintenant</span></p>
        <svg class="spark" id="cpu-spark" viewBox="0 0 600 120" preserveAspectRatio="none" role="img" aria-label="Processeur sur les dernières minutes">
          <line x1="0" x2="600" y1="30" y2="30" /><line x1="0" x2="600" y1="60" y2="60" /><line x1="0" x2="600" y1="90" y2="90" />
          <path class="ph" d="M0,96 C80,84 140,100 220,80 S360,70 440,84 S540,64 600,76" /><path class="area" d="" /><path class="ln" d="" />
        </svg>
        <div class="axis"><span id="cpu-spark-from">Collecte en cours</span><span>maintenant</span></div>
      </Card>
      {First && <First />}
    </div>

    <div class="g3">
      <Card title="Services">
        {can('services') && <a slot="actions" class="more" href="/services" data-astro-prefetch="hover">Tout voir ›</a>}
        {services === null ? <ErrorState compact title="Liste des services indisponible" text="">
          <a slot="actions" class="more" href="/services">Ouvrir Services ›</a>
        </ErrorState> : (
          <ul class="list">
            {svcRows.map((s) => (
              <li>
                <span class="who"><span class="nm">{s.name}</span><span class="mt">{s.what}</span></span>
                <StatusBadge class="st" raw={s.state} label={STATE_LABEL[s.state] ?? 'Arrêté'} size="sm" />
              </li>
            ))}
          </ul>
        )}
      </Card>
      <Card title="Stockage">
        {can('fichiers') && <a slot="actions" class="more" href="/fichiers" data-astro-prefetch="hover">Fichiers ›</a>}
        {freest && <p class="lead">{freest.label || freest.path} a le plus de place : {bytes(freest.freeBytes)} libres.</p>}
        <div class="meters">
          {disks.map((d: any) => <Meter label={d.label} value={`${bytes(d.usedBytes)} sur ${bytes(d.totalBytes)}`} percent={percent(d.usedBytes, d.totalBytes)} />)}
          {mem && mem.swapTotalBytes > 0 && <Meter label="Swap" value={`${bytes(mem.swapUsedBytes)} sur ${bytes(mem.swapTotalBytes)}`} percent={percent(mem.swapUsedBytes, mem.swapTotalBytes)} />}
        </div>
      </Card>
      {rest.map(({ Comp }) => <Comp />)}
    </div>
  </div>
</PanelLayout>

<script>
  const KEY = 'home-cpu', MAX = 72;
  function paint() {
    const home = document.getElementById('home');
    const svg = document.getElementById('cpu-spark');
    if (!home || !svg) return;
    let pts: { t: number; v: number }[] = [];
    try { pts = JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch {}
    const now = Date.now();
    if (pts.length && now - pts[pts.length - 1]!.t > 60_000) pts = [];
    if (!pts.length || now - pts[pts.length - 1]!.t > 2000) pts.push({ t: now, v: Number(home.dataset.cpu) || 0 });
    pts = pts.slice(-MAX);
    try { sessionStorage.setItem(KEY, JSON.stringify(pts)); } catch {}
    svg.classList.toggle('has-data', pts.length >= 2);
    if (pts.length < 2) return;
    const step = 600 / (MAX - 1), x0 = 600 - (pts.length - 1) * step;
    const y = (v: number) => (114 - (Math.min(100, v) / 100) * 108).toFixed(1);
    const d = pts.map((p, i) => `${i ? 'L' : 'M'}${(x0 + i * step).toFixed(1)},${y(p.v)}`).join('');
    svg.querySelector('.ln')!.setAttribute('d', d);
    svg.querySelector('.area')!.setAttribute('d', `${d}L600,120L${x0.toFixed(1)},120Z`);
    const mins = Math.max(1, Math.round((now - pts[0]!.t) / 60_000));
    document.getElementById('cpu-spark-from')!.textContent = `il y a ${mins} min`;
  }
  document.addEventListener('astro:page-load', paint);
</script>

<style>
  #home { display: flex; flex-direction: column; gap: var(--space-4); }
  #home :global(.card) { display: flex; flex-direction: column; }
  #home :global(.card__body) { flex: 1; display: flex; flex-direction: column; }
  .g2 { display: grid; gap: var(--space-4); grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); }
  .g3 { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr)); }
  .more { color: var(--accent-text); text-decoration: none; font-size: var(--meta-size); }
  .more:hover { text-decoration: underline; }

  /* Bandeau d'état (alerts-04) */
  .strip {
    --tone: var(--success); --dot: var(--success);
    display: flex; align-items: center; gap: var(--space-2) var(--space-5); flex-wrap: wrap;
    padding: var(--space-3) var(--space-5);
    background: var(--bg-surface); border-radius: var(--radius-card); box-shadow: var(--shadow-card, var(--shadow-xs));
    border-left: 3px solid var(--dot);
  }
  .strip--warning { --tone: var(--warning); --dot: var(--status-warning); }
  .strip--error { --tone: var(--danger); --dot: var(--status-error); }
  .strip--unknown { --tone: var(--text-secondary); --dot: var(--text-tertiary); }
  .strip__head { display: flex; align-items: center; gap: var(--space-2); margin: 0; font-weight: 600; color: var(--tone); white-space: nowrap; }
  .strip__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dot); box-shadow: 0 0 0 3px color-mix(in srgb, var(--dot) 22%, transparent); }
  .strip__text { flex: 1; min-width: 14rem; margin: 0; color: var(--text-secondary); font-size: var(--meta-size); line-height: var(--meta-lh); }
  .strip__go { color: var(--accent-text); text-decoration: none; font-size: var(--meta-size); font-weight: 500; }
  .strip__go:hover { text-decoration: underline; }

  /* Rangée de métriques (stat-group-01) */
  .kpis { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .kpi { display: flex; flex-direction: column; gap: 2px; min-width: 0; padding: 0 var(--space-5); border-left: 0.5px solid var(--border); }
  .kpi:first-child { padding-left: 0; border-left: 0; }
  .kpi:last-child { padding-right: 0; }
  .kpi p { margin: 0; }
  .kpi__label { display: flex; align-items: center; gap: var(--space-2); color: var(--text-secondary); font-size: var(--meta-size); }
  .kpi__label::before { content: ''; width: 8px; height: 8px; border-radius: 2px; background: var(--c); }
  .kpi__value { font: 600 1.875rem/1.15 var(--font-display); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kpi__unit { font: 500 0.875rem var(--font-ui); color: var(--text-secondary); margin-left: 3px; letter-spacing: 0; }
  .kpi__note { color: var(--text-tertiary); font-size: var(--micro-size); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kpi__bar { height: 4px; margin-top: var(--space-2); border-radius: var(--radius-pill); background: var(--bg-hover); overflow: hidden; }
  .kpi__bar span { display: block; height: 100%; width: var(--p); background: var(--c); border-radius: inherit; transition: width var(--dur-base) var(--ease-out); }
  .kpi__bar--warning span { background: var(--status-warning); }
  .kpi__bar--danger span { background: var(--status-error); }
  .kpi__bar--none { background: repeating-linear-gradient(90deg, var(--bg-hover) 0 6px, transparent 6px 10px); }
  :global(:root[data-enter]) .kpi__bar span { animation: grow 700ms var(--ease-out) both; }
  @keyframes grow { from { width: 0; } }

  /* Courbe temps réel (realtime-02) */
  .now { display: flex; align-items: baseline; gap: 3px; margin: 0 0 var(--space-2); color: var(--text-secondary); font-size: 0.875rem; }
  .now span:first-child { font: 600 1.75rem/1.1 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .now__l { margin-left: var(--space-2); color: var(--text-tertiary); font-size: var(--micro-size); }
  .spark { display: block; width: 100%; flex: 1; min-height: 120px; }
  .spark line { stroke: var(--border); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .spark .ln { fill: none; stroke: var(--res-cpu); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .spark .ph { fill: none; stroke: var(--border); stroke-width: 2; stroke-dasharray: 4 6; vector-effect: non-scaling-stroke; }
  .spark.has-data .ph { display: none; }
  .spark .area { fill: color-mix(in srgb, var(--res-cpu) 14%, transparent); }
  .axis { display: flex; justify-content: space-between; margin-top: var(--space-1); color: var(--text-tertiary); font-size: var(--micro-size); }

  /* Services (status-01) */
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; border-top: 0.5px solid var(--border); min-width: 0; }
  .list li:first-child { border-top: 0; padding-top: 0; }
  .who { display: flex; flex-direction: column; min-width: 0; }
  .nm { font-weight: 500; white-space: nowrap; }
  .mt { color: var(--text-secondary); font-size: var(--micro-size); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .list :global(.st) { margin-left: auto; flex: none; }

  /* Stockage (usage-meter-05) */
  .lead { margin: 0 0 var(--space-3); color: var(--text-secondary); font-size: var(--meta-size); }
  .meters { display: flex; flex-direction: column; gap: var(--space-4); }

  @media (prefers-reduced-motion: reduce) { :global(:root[data-enter]) .kpi__bar span { animation: none; } }
  @media (max-width: 1200px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-4); }
    .kpi:nth-child(3) { padding-left: 0; border-left: 0; }
    .kpi:nth-child(2) { padding-right: 0; }
    .g2 { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .kpis { grid-template-columns: minmax(0, 1fr); }
    .kpi { padding: 0; border-left: 0; }
  }
</style>
