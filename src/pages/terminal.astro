---
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/vault.css';

/** Recomposé avec les blocs du Vault (dashboardblocks / shadcn, MIT) : app-shell-03 (barre d'onglets de sessions), tabs, button, kbd, status-label, alert. */
export const prerender = false;

const KEYS = [
  ['\\u001b', 'Échap', null], ['\\t', 'Tab', null], ['\\u0003', 'Ctrl+C', null], ['\\u0004', 'Ctrl+D', null],
  ['\\u001b[A', '↑', 'Flèche haut'], ['\\u001b[B', '↓', 'Flèche bas'], ['\\u001b[D', '←', 'Flèche gauche'], ['\\u001b[C', '→', 'Flèche droite'],
] as const;
---
<PanelLayout title="Terminal" subtitle="Session SSH" refreshMs={null}>
  <div class="v-page v-page--wide term-wrap" id="term-wrap" data-no-shortcuts>
    <section class="v-card term-card">
      <div class="term-top">
        <div class="v-tabs" aria-label="Sessions">
          <span class="v-tab" aria-current="page"><Icon name="terminal" size={16} />Session SSH</span>
        </div>
        <button type="button" class="v-btn v-btn--ghost v-btn--sm" id="term-new"><Icon name="add" size={16} />Nouvelle session</button>
        <span class="v-status term-state" id="term-state"><span id="term-state-text">Déconnecté</span></span>
      </div>

      <div class="v-toolbar term-bar" role="toolbar" aria-label="Outils du terminal">
        <button type="button" class="v-btn v-btn--outline v-btn--sm" id="term-copy"><Icon name="copy" size={16} />Copier</button>
        <button type="button" class="v-btn v-btn--outline v-btn--sm" id="term-paste"><Icon name="clipboard" size={16} />Coller</button>
        <button type="button" class="v-btn v-btn--outline v-btn--sm" id="term-clear"><Icon name="dismiss" size={16} />Effacer</button>
        <button type="button" class="v-btn v-btn--outline v-btn--sm" id="term-sigint">Interrompre <kbd class="term-kbd">Ctrl+C</kbd></button>
        <div class="term-bar__end">
          <button type="button" class="v-btn v-btn--ghost v-btn--sm v-btn--icon" id="term-font-down" aria-label="Réduire la police" title="Réduire la police">A−</button>
          <span id="term-font" class="v-mono v-muted term-bar__font" aria-live="polite">13</span>
          <button type="button" class="v-btn v-btn--ghost v-btn--sm v-btn--icon" id="term-font-up" aria-label="Agrandir la police" title="Agrandir la police">A+</button>
          <button type="button" class="v-btn v-btn--outline v-btn--sm" id="term-full"><Icon name="open" size={16} />Plein écran</button>
        </div>
      </div>

      <div class="term-frame">
        <div id="term" class="term"></div>
      </div>

      <div class="term-keys" id="term-keys" role="group" aria-label="Touches spéciales">
        {KEYS.map(([send, label, aria]) => <button type="button" class="v-btn v-btn--outline term-key" data-send={send} aria-label={aria ?? undefined}>{label}</button>)}
      </div>

      <p id="term-msg" class="v-alert v-alert--warn term-msg" role="alert" hidden></p>

      <footer class="v-card__foot term-status" role="status">
        <span id="term-status-state">Déconnecté</span>
        <span class="term-status__sep" aria-hidden="true">·</span>
        <span id="term-size" class="v-mono">-</span>
        <span class="term-status__sep" aria-hidden="true">·</span>
        <span>SSH · UTF-8</span>
        <span class="term-status__hint"><kbd class="term-kbd">Ctrl</kbd><kbd class="term-kbd">Maj</kbd><kbd class="term-kbd">C</kbd> copier <kbd class="term-kbd">Ctrl</kbd><kbd class="term-kbd">Maj</kbd><kbd class="term-kbd">V</kbd> coller</span>
      </footer>
    </section>
  </div>
</PanelLayout>

<script>
  import '../scripts/pages/terminal';
</script>

<style>
  .term-wrap { background: var(--bg-app); }
  .term-wrap:fullscreen { padding: 0.75rem; }
  .term-wrap:fullscreen .term-card { flex: 1; min-height: 0; }
  .term-wrap:fullscreen .term-frame { flex: 1; height: auto; min-height: 0; }

  /* Fenêtre : la carte shadcn sans marges, les barres collées aux bords */
  .term-card { gap: 0; padding: 0; overflow: hidden; }
  .term-card > :global(*) { padding-inline: 0; }
  .term-top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--border); background: var(--bg-surface-2); }
  .term-state { margin-left: auto; }
  .term-bar { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
  .term-bar__end { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem; margin-left: auto; }
  .term-bar__font { min-width: 1.75rem; text-align: center; }

  .term-frame { background: var(--console-bg); height: min(70dvh, 45rem); padding: 0.75rem 1rem; box-sizing: border-box; overflow: hidden; }
  .term { height: 100%; }
  .term :global(.xterm) { height: 100%; }
  .term :global(.xterm-viewport) { background-color: var(--console-bg) !important; }

  .term-keys { display: none; gap: 0.375rem; padding: 0.5rem 0.75rem; overflow-x: auto; border-top: 1px solid var(--border); }
  .term-key { flex: 1 0 auto; min-height: 44px; min-width: 44px; touch-action: manipulation; }
  @media (pointer: coarse), (max-width: 640px) { .term-keys { display: flex; } .term-bar :global(#term-sigint) { display: none; } }

  .term-msg { margin: 0.75rem; }
  .term-msg[hidden] { display: none; }
  .term-status { padding: 0.5rem 1rem; border-top: 1px solid var(--border); flex-wrap: wrap; }
  .term-status__sep { color: var(--text-tertiary); }
  .term-status__hint { margin-left: auto; display: inline-flex; align-items: center; gap: 0.25rem; }
  .term-kbd { display: inline-flex; align-items: center; height: 1.25rem; min-width: 1.25rem; padding: 0 0.25rem; justify-content: center; border-radius: 0.25rem; background: var(--bg-hover); color: var(--text-secondary); font: 500 0.6875rem/1 var(--font-ui); }
  .term-status__hint .term-kbd:not(:first-child) { margin-left: 0; }
  @media (max-width: 640px) { .term-frame { padding: 0.5rem; height: min(60dvh, 45rem); } .term-status__hint { display: none; } }
</style>
