---
import { resolve } from 'node:path';
import PanelLayout from '../layouts/PanelLayout.astro';
import SettingsGroup from '../components/ui/SettingsGroup.astro';
import SettingsRow from '../components/ui/SettingsRow.astro';
import Button from '../components/ui/Button.astro';
import Segmented from '../components/ui/Segmented.astro';
import { PANEL_NAME } from '../server/core/panel';
import pkg from '../../package.json';

export const prerender = false;

const publicUrl = String(process.env.PANEL_PUBLIC_URL ?? '').split(',')[0].trim().replace(/\/+$/, '') || Astro.url.origin;
const dataDir = process.env.PANEL_DATA_DIR ?? resolve('data');
const build = import.meta.env.BUILD_ID;
---
<PanelLayout title="Paramètres" subtitle="Apparence et informations sur cette instance du panel" refreshMs={null}>
  <div class="settings">
    <SettingsGroup title="Apparence">
      <SettingsRow icon="theme" title="Thème" desc="Système : suit le réglage clair ou sombre de l’appareil.">
        <Segmented label="Thème" attr="theme-set" selected="system" options={[
          { value: 'light', label: 'Clair', icon: 'sun' },
          { value: 'dark', label: 'Sombre', icon: 'moon' },
          { value: 'system', label: 'Système', icon: 'monitor' },
        ]} />
      </SettingsRow>
      <SettingsRow icon="panelLeft" title="Menu" desc="Automatique : réduit aux icônes quand la fenêtre est étroite. Mémorisé sur cet appareil.">
        <Segmented label="Largeur du menu" attr="nav-set" selected="auto" options={[
          { value: 'expanded', label: 'Complet' },
          { value: 'compact', label: 'Compact' },
          { value: 'auto', label: 'Automatique' },
        ]} />
      </SettingsRow>
    </SettingsGroup>

    <SettingsGroup title="Instance">
      <SettingsRow icon="server" title="Nom du panel" desc="Nom affiché en haut du menu.">{PANEL_NAME}</SettingsRow>
      <SettingsRow icon="box" title="Version"><span class="mono">{pkg.version}{build ? ` · build ${build}` : ''}</span></SettingsRow>
      <SettingsRow icon="globe" title="Adresse" desc="Adresse publique de ce panel."><span class="mono wrap">{publicUrl}</span><Button size="sm" iconOnly icon="copy" label="Copier l’adresse" data-copy={publicUrl} /></SettingsRow>
      <SettingsRow icon="database" title="Dossier de données" desc="Comptes, modules installés et réglages."><span class="mono wrap">{dataDir}</span><Button size="sm" iconOnly icon="copy" label="Copier le chemin" data-copy={dataDir} /></SettingsRow>
    </SettingsGroup>

    <SettingsGroup title="Administration">
      <SettingsRow icon="store" title="Magasin" desc="Installer ou désinstaller les intégrations du panel." href="/modules" />
      <SettingsRow icon="users" title="Utilisateurs" desc="Comptes, droits par onglet et protection par connexion." href="/acces" />
    </SettingsGroup>
  </div>
  {/* Pose l'état choisi avant le premier rendu (shell.ts le fait trop tard : flash du mauvais choix). */}
  <script is:inline>
    (function () {
      var v = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
      var t = v('panel-theme'), n = v('panel-nav');
      t = t === 'light' || t === 'dark' ? t : 'system';
      n = n === 'compact' || n === 'expanded' ? n : 'auto';
      document.querySelectorAll('[data-theme-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.themeSet === t)); });
      document.querySelectorAll('[data-nav-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.navSet === n)); });
    })();
  </script>
</PanelLayout>

<script>
  import { toast } from '../scripts/ui/dialog';
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        toast('Copié.', 'success', 1500);
      } catch {
        toast('Le navigateur refuse la copie.', 'error');
      }
    }));
  });
</script>

<style>
  .settings { display: flex; flex-direction: column; gap: var(--space-6); max-width: 52rem; }
  .mono { font-family: var(--font-mono); font-size: var(--meta-size); color: var(--text-primary); }
  .wrap { overflow-wrap: anywhere; text-align: right; }
  @media (max-width: 640px) {
    .wrap { text-align: left; }
    .settings :global(.srow__end) { padding-left: 0; }
    .settings :global(.seg) { width: 100%; }
    .settings :global(.seg__btn) { flex: 1; justify-content: center; }
  }
</style>
