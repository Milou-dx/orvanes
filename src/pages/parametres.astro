---
/**
 * Paramètres, recomposés avec les primitives settings du Vault (dashboardblocks, MIT) :
 * une carte par section, des lignes libellé + description à gauche et contrôle à droite.
 */
import { resolve } from 'node:path';
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { PANEL_NAME } from '../server/core/panel';
import pkg from '../../package.json';
import { readFileSync } from 'node:fs';
import { FEEDBACK_FILE } from './api/feedback';
import '../styles/vault.css';

export const prerender = false;

const me: any = Astro.locals.user;
const showTotp = Astro.locals.authEnabled && Boolean(me?.password);
const hasTotp = Boolean(me?.totp?.secret);
const publicUrl = String(process.env.PANEL_PUBLIC_URL ?? '').split(',')[0].trim().replace(/\/+$/, '') || Astro.url.origin;
const dataDir = process.env.PANEL_DATA_DIR ?? resolve('data');
const build = import.meta.env.BUILD_ID;
const KIND: Record<string, string> = { bug: 'Bug', idee: 'Idée', autre: 'Autre' };
let feedback: { at: string; kind?: string; user: string | null; page: string; title: string; selection: string; text: string }[] = [];
try { feedback = readFileSync(FEEDBACK_FILE, 'utf8').trim().split('\n').filter(Boolean).map((l) => JSON.parse(l)).reverse().slice(0, 50); } catch {}
const when = (iso: string) => new Date(iso).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' });
const THEMES = [['light', 'Clair', 'sun'], ['dark', 'Sombre', 'moon'], ['system', 'Système', 'monitor']] as const;
const NAVS = [['expanded', 'Complet'], ['compact', 'Compact'], ['auto', 'Automatique']] as const;
const LINKS = [
  { href: '/modules', label: 'Magasin', desc: 'Installer, mettre à jour ou retirer les intégrations du panel.' },
  { href: '/acces', label: 'Utilisateurs', desc: 'Comptes, droits par onglet, connexion Google et protection.' },
];
---
<PanelLayout title="Paramètres" subtitle="Apparence et informations sur cette instance du panel" refreshMs={null}>
  <div class="v-page">
    <section class="v-card">
      <header class="v-card__head">
        <div class="v-card__titles">
          <h2 class="v-card__title">Apparence</h2>
          <p class="v-card__desc">Propre à cet appareil : le choix est gardé dans ce navigateur.</p>
        </div>
      </header>
      <div>
        <div class="v-row">
          <div class="v-row__txt"><span class="v-row__label">Thème</span><span class="v-row__desc">Système suit le réglage clair ou sombre de l’appareil.</span></div>
          <div class="v-tabs" role="group" aria-label="Thème">
            {THEMES.map(([v, label, icon]) => <button type="button" class="v-tab" data-theme-set={v} aria-pressed={v === 'system'}><Icon name={icon} size={16} />{label}</button>)}
          </div>
        </div>
        <div class="v-row">
          <div class="v-row__txt"><span class="v-row__label">Menu</span><span class="v-row__desc">Automatique le réduit aux icônes quand la fenêtre est étroite.</span></div>
          <div class="v-tabs" role="group" aria-label="Largeur du menu">
            {NAVS.map(([v, label]) => <button type="button" class="v-tab" data-nav-set={v} aria-pressed={v === 'auto'}>{label}</button>)}
          </div>
        </div>
      </div>
    </section>

    {showTotp && <section class="v-card">
      <header class="v-card__head">
        <div class="v-card__titles">
          <h2 class="v-card__title">Sécurité</h2>
          <p class="v-card__desc">Propre à votre compte. Code perdu : <code>node scripts/admin.mjs reset &lt;identifiant&gt;</code> sur le serveur.</p>
        </div>
      </header>
      <div class="v-row">
        <div class="v-row__txt"><span class="v-row__label">Double authentification</span><span class="v-row__desc">{hasTotp ? 'Active : un code est demandé à la connexion par mot de passe.' : 'Demande un code à usage unique en plus du mot de passe.'}</span></div>
        <button type="button" class="v-btn v-btn--outline" data-totp={hasTotp ? 'off' : 'on'}>{hasTotp ? 'Désactiver' : 'Activer'}</button>
      </div>
    </section>}

    <section class="v-card">
      <header class="v-card__head">
        <div class="v-card__titles">
          <h2 class="v-card__title">Instance</h2>
          <p class="v-card__desc">Ce qui identifie ce panel. Ces valeurs viennent de la configuration du serveur.</p>
        </div>
        <span class="v-status v-status--good">En ligne</span>
      </header>
      <div>
        <div class="v-row">
          <div class="v-row__txt"><span class="v-row__label">Nom du panel</span><span class="v-row__desc">Affiché en haut du menu.</span></div>
          <span class="v-row__ctl v-label">{PANEL_NAME}</span>
        </div>
        <div class="v-row">
          <div class="v-row__txt"><span class="v-row__label">Version</span></div>
          <span class="v-row__ctl"><span class="v-badge v-mono">{pkg.version}</span>{build && <span class="v-badge v-mono">build {build}</span>}</span>
        </div>
        <div class="v-row">
          <div class="v-row__txt"><span class="v-row__label">Adresse</span><span class="v-row__desc v-mono">{publicUrl}</span></div>
          <button type="button" class="v-btn v-btn--outline v-btn--sm" data-copy={publicUrl}><Icon name="copy" size={16} />Copier</button>
        </div>
        <div class="v-row">
          <div class="v-row__txt"><span class="v-row__label">Dossier de données</span><span class="v-row__desc v-mono">{dataDir}</span></div>
          <button type="button" class="v-btn v-btn--outline v-btn--sm" data-copy={dataDir}><Icon name="copy" size={16} />Copier</button>
        </div>
      </div>
    </section>

    <section class="v-card">
      <header class="v-card__head">
        <div class="v-card__titles">
          <h2 class="v-card__title">Administration</h2>
          <p class="v-card__desc">Les autres pages de réglage, réservées aux administrateurs.</p>
        </div>
      </header>
      <div>
        {LINKS.map((l) => (
          <div class="v-row">
            <div class="v-row__txt"><span class="v-row__label">{l.label}</span><span class="v-row__desc">{l.desc}</span></div>
            <a class="v-btn v-btn--outline v-btn--sm" href={l.href} data-astro-prefetch="hover">Ouvrir<Icon name="chevronRight" size={16} /></a>
          </div>
        ))}
      </div>
    </section>
    <section class="v-card">
      <header class="v-card__head">
        <div class="v-card__titles">
          <h2 class="v-card__title">Commentaires reçus</h2>
          <p class="v-card__desc">Envoyés depuis le menu du compte. Les 50 derniers, du plus récent au plus ancien.</p>
        </div>
        <span class="v-badge">{feedback.length}</span>
      </header>
      <div>
        {feedback.length === 0 && <div class="v-row"><span class="v-row__desc">Aucun commentaire pour l’instant.</span></div>}
        {feedback.map((f) => (
          <div class="v-row">
            <div class="v-row__txt">
              <span class="v-row__label"><span class="v-badge">{KIND[f.kind ?? 'autre'] ?? 'Autre'}</span> {f.text}</span>
              <span class="v-row__desc">{f.user ?? 'Anonyme'} · <a href={f.page}>{f.title || f.page}</a>{f.selection && ` · « ${f.selection.slice(0, 120)} »`}</span>
            </div>
            <span class="v-row__ctl v-mono">{when(f.at)}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
  {/* Pose l'état choisi avant le premier rendu (shell.ts le fait trop tard : flash du mauvais choix). */}
  <script is:inline>
    (function () {
      var v = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
      var t = v('panel-theme'), n = v('panel-nav');
      t = t === 'light' || t === 'dark' ? t : 'system';
      n = n === 'compact' || n === 'expanded' ? n : 'auto';
      document.querySelectorAll('[data-theme-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.themeSet === t)); });
      document.querySelectorAll('[data-nav-set]').forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.navSet === n)); });
    })();
  </script>
</PanelLayout>

<script>
  import '../scripts/pages/totp';
  import { toast } from '../scripts/ui/dialog';
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        toast('Copié.', 'success', 1500);
      } catch {
        toast('Le navigateur refuse la copie.', 'error');
      }
    }));
  });
</script>
