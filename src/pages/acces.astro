---
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/vault.css';
import { adminOverview, googleConfigured } from '../server/auth/auth';
import { tabs as panelTabs } from '../server/auth/auth-core.js';
import { ago, tone } from '../server/core/format';
import { PANEL_NAME } from '../server/core/panel';
import { isInstalled } from '../server/modules/registry.js';

/** Recomposé avec les blocs du Vault (dashboardblocks, MIT) : settings-01 (membres), settings-03 (droits en interrupteurs), team (avatars), status-label. */
export const prerender = false;

const VIEWS = [
  ['utilisateurs', 'Utilisateurs'],
  ['droits', 'Droits par onglet'],
  ['google', 'Connexion Google'],
  ['securite', 'Sécurité'],
] as const;
const asked = Astro.url.searchParams.get('vue');
const vue = VIEWS.find(([k]) => k === asked)?.[0] ?? 'utilisateurs';

const ov = adminOverview();
const linux = isInstalled('claude');
const tabs = panelTabs().filter((t) => !t.adminOnly);
const pendingUsers = ov.users.filter((u) => u.status === 'pending');
const users = [...ov.users].sort(
  (a, b) => Number(b.status === 'pending') - Number(a.status === 'pending') || Number(b.role === 'admin') - Number(a.role === 'admin') || a.name.localeCompare(b.name, 'fr'),
);
const admins = ov.users.filter((u) => u.role === 'admin' && u.status === 'active');
const rescue = admins.filter((u) => u.hasPassword);
const initials = (name: string) => name.split(/[\s@._-]+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('') || '?';
const statusOf = (s: string) =>
  s === 'active' ? { tone: 'good', label: 'Actif' } : s === 'pending' ? { tone: 'warning', label: 'En attente' } : { tone: 'bad', label: 'Bloqué' };
const data = JSON.stringify({ users: ov.users, tabs: tabs.map((t) => ({ id: t.id, label: t.label, sensitive: t.sensitive })), enabled: ov.enabled, google: googleConfigured() }).replace(/</g, '\\u003c');
const members = users.filter((u) => u.role !== 'admin');
const plural = (n: number, w: string) => `${n} ${w}${n > 1 ? 's' : ''}`;
const summary = `${plural(admins.length, 'administrateur')} et ${plural(members.filter((u) => u.status === 'active').length, 'utilisateur')}${pendingUsers.length ? `, ${plural(pendingUsers.length, 'demande')} en attente` : ''} · protection ${ov.enabled ? 'activée' : 'désactivée'}`;
const groups = [
  { title: 'Onglets sensibles', desc: 'Donnent la main sur la machine.', items: tabs.filter((t) => t.sensitive) },
  { title: 'Autres onglets', desc: 'Consultation et outils sans accès au système.', items: tabs.filter((t) => !t.sensitive) },
].filter((g) => g.items.length);
const access = (u: (typeof users)[number]) => (u.role === 'admin' ? tabs.length : u.tabs.filter((t) => tabs.some((x) => x.id === t)).length);
const redirectUri = `${Astro.url.origin}/api/auth/google/callback`;
---
<PanelLayout title="Utilisateurs" subtitle={summary} refreshMs={null}>
  <script is:inline type="application/json" id="acces-data" set:html={data}></script>

  <div class="v-page acces">
    <nav class="v-tabs" aria-label="Sections de l’administration des accès">
      {VIEWS.map(([k, label]) => (
        <a class="v-tab" href={`/acces?vue=${k}`} aria-current={k === vue ? 'page' : undefined} data-astro-prefetch="hover">
          {label}{k === 'utilisateurs' && pendingUsers.length > 0 && <span class="v-tag">{pendingUsers.length}</span>}
        </a>
      ))}
    </nav>

    {!ov.enabled && (
      <div class="v-alert v-alert--warn" role="alert">
        <strong>La protection est inactive.</strong>
        <span>Toute personne qui atteint le panel y entre sans se connecter. <a href="/acces?vue=securite">Voir comment l’activer</a>.</span>
      </div>
    )}

    {vue === 'utilisateurs' && (
      <section class="v-card">
        <header class="v-card__head">
          <div class="v-card__titles">
            <h2 class="v-card__title">Membres</h2>
            <p class="v-card__desc">{summary.split(' · ')[0]}. Un administrateur voit tous les onglets ; un utilisateur ne voit que ceux que vous lui donnez.</p>
          </div>
          <button type="button" class="v-btn" id="acces-new"><Icon name="add" size={16} />Nouvel utilisateur</button>
        </header>

        <div class="search">
          <label class="v-label" for="acces-q">Rechercher</label>
          <input class="v-input" id="acces-q" type="search" placeholder="Nom ou adresse" autocomplete="off" />
        </div>

        {pendingUsers.length > 0 && (
          <section aria-labelledby="acces-pending">
            <h3 class="v-h3" id="acces-pending">{plural(pendingUsers.length, 'demande')} d’accès en attente</h3>
            <ul class="v-list">
              {pendingUsers.map((u) => (
                <li data-q={`${u.name} ${u.email}`.toLowerCase()}>
                  <span class="v-avatar" style={`--c:${tone(u.name)}`} aria-hidden="true">{initials(u.name)}{u.picture && <img src={u.picture} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />}</span>
                  <span class="v-who"><span class="v-who__name">{u.name}</span><span class="v-who__sub">{u.email} · inscrit il y a {ago(u.createdAt)}</span></span>
                  <button type="button" class="v-btn v-btn--sm" data-edit={u.id}>Approuver…</button>
                  <button type="button" class="v-btn v-btn--sm v-btn--danger" data-block={u.id} data-name={u.name}>Refuser</button>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section aria-labelledby="acces-members">
          <h3 class="v-h3" id="acces-members">{plural(users.length, 'compte')}</h3>
          {users.length === 0 ? <p class="v-muted empty">Aucun compte. Créez le premier avec « Nouvel utilisateur ».</p> : (
            <ul class="v-list" id="acces-list">
              {users.map((u) => {
                const st = statusOf(u.status);
                const n = access(u);
                return (
                  <li data-q={`${u.name} ${u.email} ${u.linuxUser ?? ''}`.toLowerCase()}>
                    <span class:list={['v-avatar', u.sessions > 0 && 'v-avatar--on']} style={`--c:${tone(u.name)}`} aria-hidden="true">{initials(u.name)}{u.picture && <img src={u.picture} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />}</span>
                    <span class="v-who">
                      <span class="v-who__name">{u.name}{u.sessions > 0 && <span class="visually-hidden"> (session ouverte)</span>}</span>
                      <span class="v-who__sub">{u.email}{u.hasPassword ? ' · mot de passe' : ''}{linux && u.role !== 'admin' && (u.linuxUser ? ` · Linux ${u.linuxUser}` : ' · sans compte Linux')}</span>
                    </span>
                    <span class="col col--role v-muted">{u.role === 'admin' ? 'Administrateur' : 'Utilisateur'}</span>
                    <span class="col col--tabs v-badge">{u.role === 'admin' ? 'Tous les onglets' : `${n}/${tabs.length} onglets`}</span>
                    <span class="col col--last v-muted" title={u.sessions > 0 ? `${plural(u.sessions, 'session')} ouverte${u.sessions > 1 ? 's' : ''}` : undefined}>{u.lastLoginAt ? `il y a ${ago(u.lastLoginAt)}` : 'jamais connecté'}</span>
                    <span class:list={['col', 'v-status', `v-status--${st.tone}`]}>{st.label}</span>
                    <span class="acts">
                      <button type="button" class="v-btn v-btn--outline v-btn--sm" data-edit={u.id}>Modifier</button>
                      <button type="button" class="v-btn v-btn--ghost v-btn--sm v-btn--icon" aria-label={`Autres actions pour ${u.name}`} aria-haspopup="menu" aria-expanded="false"
                        data-more={u.id} data-name={u.name} data-admin={u.role === 'admin' ? '' : undefined}
                        data-linux={linux && u.role !== 'admin' ? '' : undefined} data-sessions={u.sessions}><Icon name="more" size={16} /></button>
                    </span>
                  </li>
                );
              })}
            </ul>
          )}
          <p class="v-muted empty" id="acces-none" hidden>Aucun compte ne correspond.</p>
        </section>

        <footer class="v-card__foot">
          Les onglets sensibles donnent la main sur la machine.{linux && ' Un utilisateur lié à un compte Linux utilise Claude sous ce compte, enfermé dans son dossier personnel ; sans compte Linux, Claude ne fait que consulter.'}
        </footer>
      </section>
    )}

    {vue === 'droits' && (
      <section class="v-card">
        <header class="v-card__head">
          <div class="v-card__titles">
            <h2 class="v-card__title">Droits par onglet</h2>
            <p class="v-card__desc">Chaque interrupteur ouvre un onglet à un utilisateur, enregistré dès le clic. Les administrateurs ({admins.length}) voient tout et n’apparaissent pas ici.</p>
          </div>
        </header>
        {members.length === 0 ? (
          <div class="empty">
            <p class="v-muted">Aucun utilisateur à configurer. Créez un utilisateur non administrateur pour lui attribuer des onglets.</p>
            <a class="v-btn v-btn--outline v-btn--sm" href="/acces?vue=utilisateurs">Aller aux membres</a>
          </div>
        ) : (
          <div class="mx-wrap" tabindex="0" role="region" aria-label="Droits par onglet, défilement horizontal">
            <table class="mx" id="matrix">
              <thead>
                <tr>
                  <th scope="col" class="mx-tab">Onglet</th>
                  {members.map((u) => (
                    <th scope="col" class:list={['mx-user', u.status !== 'active' && 'is-off']}>
                      <span class="v-avatar" style={`--c:${tone(u.name)}`} aria-hidden="true">{initials(u.name)}{u.picture && <img src={u.picture} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />}</span>
                      <span class="mx-user__n">{u.name}</span>
                      <span class="mx-user__c" data-mx-count={u.id}>{access(u)}/{tabs.length}</span>
                      {u.status !== 'active' && <span class="mx-user__c">{statusOf(u.status).label}</span>}
                    </th>
                  ))}
                </tr>
              </thead>
              {groups.map((g) => (
                <tbody>
                  <tr class="mx-group"><th scope="rowgroup" colspan={members.length + 1}><span class="v-label">{g.title}</span> <span class="v-muted">{g.desc}</span></th></tr>
                  {g.items.map((t) => (
                    <tr>
                      <th scope="row" class="mx-tab">{t.label}</th>
                      {members.map((u) => (
                        <td class="mx-cell">
                          <input type="checkbox" class="v-switch" data-mx-user={u.id} data-mx-tab={t.id} checked={u.tabs.includes(t.id)} aria-label={`${u.name} : ${t.label}`} />
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
        )}
      </section>
    )}

    {vue === 'google' && (
      <>
        <form id="google-form" class="v-card">
          <header class="v-card__head">
            <div class="v-card__titles">
              <h2 class="v-card__title">Connexion avec Google</h2>
              <p class="v-card__desc">Ajoute « Se connecter avec Google » à l’écran de connexion. Un compte Google inconnu apparaît en attente ; vous décidez de son accès.</p>
            </div>
            <span class:list={['v-status', ov.google.configured ? 'v-status--good' : '']}>{ov.google.configured ? 'Configurée' : 'Non configurée'}</span>
          </header>
          <div>
            <div class="v-row">
              <label class="v-row__txt" for="g-id"><span class="v-row__label">ID client</span><span class="v-row__desc">Se termine par apps.googleusercontent.com.</span></label>
              <input id="g-id" class="v-input v-mono" value={ov.google.clientId} placeholder="123456789-abc…apps.googleusercontent.com" autocomplete="off" spellcheck="false" />
            </div>
            <div class="v-row">
              <label class="v-row__txt" for="g-secret"><span class="v-row__label">Code secret du client</span><span class="v-row__desc">{ov.google.hasSecret ? 'Laissé vide, le code enregistré ne change pas.' : 'Commence par GOCSPX-.'}</span></label>
              <input id="g-secret" class="v-input v-mono" type="password" placeholder={ov.google.hasSecret ? '••••••••' : 'GOCSPX-…'} autocomplete="off" spellcheck="false" />
            </div>
          </div>
          <footer class="v-card__foot foot-end">
            <p id="google-msg" class="msg" hidden></p>
            <button type="button" class="v-btn v-btn--outline" id="google-test" disabled={!ov.google.configured}>Tester auprès de Google</button>
            <button type="submit" class="v-btn">Enregistrer</button>
          </footer>
        </form>

        <section class="v-card">
          <header class="v-card__head">
            <div class="v-card__titles">
              <h2 class="v-card__title">Créer vos identifiants Google</h2>
              <p class="v-card__desc">Cinq étapes dans la console Google Cloud, à faire une fois.</p>
            </div>
          </header>
          <ol class="steps">
            <li>Ouvrez la <a href="https://console.cloud.google.com/projectcreate" target="_blank" rel="noopener">console Google Cloud</a> et créez un projet (par exemple « {PANEL_NAME} »).</li>
            <li>Dans « API et services » → <a href="https://console.cloud.google.com/apis/credentials/consent" target="_blank" rel="noopener">Écran de consentement OAuth</a> : type <strong>Externe</strong>, nom « {PANEL_NAME} ». Gardez l’état <strong>Test</strong> et ajoutez comme <strong>utilisateurs de test</strong> les adresses Gmail autorisées à se connecter, la vôtre incluse.</li>
            <li>Dans <a href="https://console.cloud.google.com/apis/credentials" target="_blank" rel="noopener">Identifiants</a> → « Créer des identifiants » → « ID client OAuth » → type d’application : <strong>Application Web</strong>.</li>
            <li>Dans « URI de redirection autorisés », ajoutez : <code class="v-mono">{redirectUri}</code></li>
            <li>Copiez l’<strong>ID client</strong> et le <strong>code secret</strong> dans le formulaire ci-dessus, puis enregistrez et testez.</li>
          </ol>
          <footer class="v-card__foot">Google n’accepte qu’une adresse de retour en HTTPS : le bouton passe par le domaine public, pas par l’adresse Tailscale. L’identifiant et le mot de passe restent disponibles partout.</footer>
        </section>
      </>
    )}

    {vue === 'securite' && (
      <>
        <section class="v-card">
          <header class="v-card__head">
            <div class="v-card__titles">
              <h2 class="v-card__title">Protection par connexion</h2>
              <p class="v-card__desc">Activée : écran de connexion et onglets limités par compte, terminal et Claude inclus. Désactivée : le panel reste ouvert.</p>
            </div>
            <button type="button" role="switch" class="v-switch" id="acces-enable" aria-checked={ov.enabled ? 'true' : 'false'} aria-label="Protection par connexion"></button>
          </header>
        </section>

        <section class="v-card">
          <header class="v-card__head">
            <div class="v-card__titles">
              <h2 class="v-card__title">Avant d’activer</h2>
              <p class="v-card__desc">Ce qu’il faut pour ne pas vous enfermer dehors.</p>
            </div>
          </header>
          <div>
            <div class="v-row">
              <div class="v-row__txt"><span class="v-row__label">Compte de secours</span><span class="v-row__desc">Un administrateur avec identifiant et mot de passe, utilisable si Google ne répond plus. Requis.</span></div>
              <span class="v-row__ctl">
                <span class:list={['v-status', rescue.length ? 'v-status--good' : 'v-status--warning']}>{rescue.length ? plural(rescue.length, 'compte') : 'À créer'}</span>
                {!rescue.length && admins[0] && <button type="button" class="v-btn v-btn--outline v-btn--sm" data-password={admins[0].id} data-name={admins[0].name}>Définir le mot de passe de {admins[0].name}</button>}
              </span>
            </div>
            <div class="v-row">
              <div class="v-row__txt"><span class="v-row__label">Connexion Google</span><span class="v-row__desc">Facultative : sans elle, on se connecte par identifiant et mot de passe.</span></div>
              <span class:list={['v-status', ov.google.configured ? 'v-status--good' : '']}>{ov.google.configured ? 'Configurée' : 'Non configurée'}</span>
            </div>
          </div>
        </section>

        <section class="v-card">
          <header class="v-card__head">
            <div class="v-card__titles">
              <h2 class="v-card__title">Ce qui est protégé</h2>
              <p class="v-card__desc">La protection couvre le panel, pas les sites qu’il relaie.</p>
            </div>
          </header>
          <div>
            <div class="v-row">
              <div class="v-row__txt"><span class="v-row__label">Le panel</span><span class="v-row__desc">Toutes les pages, leurs fonctions, et les WebSockets du terminal et de Claude.</span></div>
              <span class="v-status v-status--good">Protégé</span>
            </div>
            <div class="v-row">
              <div class="v-row__txt"><span class="v-row__label">Les sites relayés</span><span class="v-row__desc">Les sites du relais (par exemple /blog ou /docs) et les applications restent publics.</span></div>
              <span class="v-status">Public</span>
            </div>
            <div class="v-row">
              <div class="v-row__txt"><span class="v-row__label">Durée d’une session</span></div>
              <span class="v-label">{ov.sessionDays} jours</span>
            </div>
          </div>
        </section>

        <div class="v-alert">
          <strong>Verrouillé hors du panel ?</strong>
          <span>En SSH sur la machine, supprimez <span class="v-mono">data/auth.json</span> du dossier d’installation du panel (ou mettez <span class="v-mono">"enabled": false</span>) : la protection s’arrête à la requête suivante.</span>
        </div>
      </>
    )}
  </div>
</PanelLayout>

<script>
  import '../scripts/pages/acces';
  // Recherche dans la liste des membres (remplace la barre d'outils du tableau).
  document.addEventListener('astro:page-load', () => {
    const q = document.getElementById('acces-q') as HTMLInputElement | null;
    q?.addEventListener('input', () => {
      const v = q.value.trim().toLowerCase();
      let shown = 0;
      document.querySelectorAll<HTMLElement>('.acces li[data-q]').forEach((li) => { li.hidden = !!v && !li.dataset.q!.includes(v); if (!li.hidden) shown++; });
      document.getElementById('acces-none')!.hidden = shown > 0;
    });
  });
</script>

<style>
  .search { display: flex; flex-direction: column; gap: 0.5rem; }
  .empty { margin: 0; padding: 1.5rem 0; text-align: center; display: grid; justify-items: center; gap: 0.75rem; }
  .col { flex: none; }
  .col--role { width: 7.5rem; }
  .col--last { width: 9rem; text-align: right; }
  .acts { flex: none; display: flex; gap: 0.25rem; }
  .v-list > li[hidden] { display: none; }
  .steps { margin: 0; padding-left: 3rem; display: grid; gap: 0.5rem; font-size: 0.875rem; line-height: 1.5; color: var(--text-secondary); }
  .steps strong { color: var(--text-primary); font-weight: 500; }
  .steps a { color: var(--accent-text); }
  .foot-end { justify-content: flex-end; flex-wrap: wrap; }
  .msg { margin: 0 auto 0 0; font-size: 0.875rem; }

  .mx-wrap { overflow: auto; max-height: 75dvh; padding-inline: 0 !important; border-top: 1px solid var(--border); }
  .mx { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 0.875rem; }
  .mx th, .mx td { border-bottom: 1px solid var(--border); background: var(--bg-surface); }
  .mx thead th { position: sticky; top: 0; z-index: 2; text-align: center; vertical-align: bottom; padding: 0.75rem 0.5rem; min-width: 6.5rem; font-weight: 500; color: var(--text-primary); }
  .mx .mx-tab { position: sticky; left: 0; z-index: 1; text-align: left; padding: 0.625rem 1.5rem; min-width: 10rem; font-weight: 400; color: var(--text-primary); }
  .mx thead .mx-tab { z-index: 3; font-weight: 500; vertical-align: bottom; }
  .mx-group th { text-align: left; padding: 1rem 1.5rem 0.5rem; font-weight: 400; background: var(--bg-surface); }
  .mx-user .v-avatar { margin: 0 auto 0.375rem; }
  .mx-user__n { display: block; overflow-wrap: anywhere; }
  .mx-user__c { display: block; font-size: 0.75rem; font-weight: 400; color: var(--text-secondary); font-variant-numeric: tabular-nums; }
  .mx-user.is-off { opacity: 0.7; }
  .mx-cell { text-align: center; padding: 0.5rem; }
  .mx tbody:last-child tr:last-child > * { border-bottom: 0; }

  @media (max-width: 900px) { .col--role, .col--last, .col--tabs { display: none; } }
  @media (max-width: 640px) {
    .v-list > li { flex-wrap: wrap; }
    .acts { width: 100%; padding-left: 2.75rem; }
    .steps { padding-left: 2.25rem; }
  }

  /* Formulaires des fenêtres (créés par scripts/pages/acces.ts). */
  :global(.acform) { display: grid; gap: var(--space-3); min-width: min(32rem, 100%); }
  :global(.acform__field) { display: grid; gap: var(--space-1); font-size: var(--dense-size); color: var(--text-secondary); }
  :global(.acform__row) { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr)); }
  :global(.acform select), :global(.acform input[type='text']) { height: var(--control-h); padding: 0 var(--space-2); border-radius: var(--radius-sm); border: var(--border-width) solid var(--field-stroke); background: var(--bg-app); color: var(--text-primary); font: inherit; }
  :global(.actabs) { display: grid; gap: var(--space-0-5); max-height: 18rem; overflow: auto; padding: var(--space-1); border: var(--border-width) solid var(--border); border-radius: var(--radius-sm); }
  :global(.actabs label) { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2); min-height: var(--control-h); border-radius: var(--radius-xs); color: var(--text-primary); cursor: pointer; }
  :global(.actabs label:hover) { background: var(--bg-hover); }
  :global(.actabs small) { color: var(--warning); margin-left: auto; font-size: var(--meta-size); }
  :global(.acquick) { display: flex; gap: var(--space-2); }
  :global(.acpass) { font-family: var(--font-mono); font-size: var(--section-size); letter-spacing: .04em; text-align: center; padding: var(--space-3); border-radius: var(--radius-sm); background: var(--bg-app); border: var(--border-width) dashed var(--border-strong); user-select: all; overflow-wrap: anywhere; }
</style>
