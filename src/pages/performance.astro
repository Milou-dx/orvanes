---
import os from 'node:os';
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/vault.css';
import { bytes, duration, num, percent } from '../server/core/format';
import { safe } from '../server/core/safe';
import * as sys from '../server/system/system.js';
import { tabAllowed } from '../layouts/nav';

/** Recomposé avec les blocs du Vault (dashboardblocks, MIT) : metric-list-03 (ressources à choisir), realtime-02 (courbe en direct), stat-group-01 (chiffres), usage-meter-05 (disques), settings (détails). */
export const prerender = false;

const can = tabAllowed(Astro.locals);

const [mem, disks, load, cpuPercent, perCore, uptime] = await Promise.all([
  safe(() => sys.getMemory(), null),
  safe(() => sys.getDisks(), [] as any[]),
  safe(() => sys.getLoadAverage(), null as number[] | null),
  safe(() => sys.getCpuPercent(), null as number | null),
  safe(() => sys.getCpuPerCorePercent(), [] as (number | null)[]),
  safe(() => sys.getUptimeSeconds(), null as number | null),
]);

const cores = os.cpus().length || perCore.length || 1;
const arch = /aarch64|arm64/i.test(os.arch()) ? 'ARM64' : /x64|x86_64|amd64/i.test(os.arch()) ? 'x64' : os.arch();
const memPct = mem ? percent(mem.usedBytes, mem.totalBytes) : 0;
const loadLine = load ? load.map((l: number) => num(l, 2)).join(' · ') : '-';

type Det = { label: string; value: string; id?: string };
const DETAILS: Record<string, Det[]> = {
  cpu: [
    { label: 'Moyenne sur la fenêtre', value: '-', id: 'cpu-avg' },
    { label: 'Pic sur la fenêtre', value: '-', id: 'cpu-peak' },
    { label: 'Cœurs logiques', value: String(cores) },
    { label: 'Architecture', value: arch },
  ],
  mem: [
    { label: 'Mémoire installée', value: mem ? bytes(mem.totalBytes) : '-' },
    { label: 'Moyenne sur la fenêtre', value: '-', id: 'mem-avg' },
    { label: 'Pic sur la fenêtre', value: '-', id: 'mem-peak' },
    { label: 'Taille du fichier d’échange', value: mem ? bytes(mem.swapTotalBytes) : '-' },
  ],
  disk: [
    { label: 'Lecture, moyenne', value: '-', id: 'disk-read-avg' },
    { label: 'Lecture, pic', value: '-', id: 'disk-read-peak' },
    { label: 'Écriture, moyenne', value: '-', id: 'disk-write-avg' },
    { label: 'Écriture, pic', value: '-', id: 'disk-write-peak' },
  ],
  net: [
    { label: 'Réception, moyenne', value: '-', id: 'net-rx-avg' },
    { label: 'Réception, pic', value: '-', id: 'net-rx-peak' },
    { label: 'Envoi, moyenne', value: '-', id: 'net-tx-avg' },
    { label: 'Envoi, pic', value: '-', id: 'net-tx-peak' },
  ],
};

const TABS = [
  { id: 'cpu',  name: 'Processeur', sub: cpuPercent != null ? `${num(cpuPercent, 0)} %` : '-' },
  { id: 'mem',  name: 'Mémoire',    sub: mem ? `${bytes(mem.usedBytes)} / ${bytes(mem.totalBytes)} (${num(memPct, 0)} %)` : '-' },
  { id: 'disk', name: 'Disque',     sub: '-' },
  { id: 'net',  name: 'Ethernet',   sub: '-' },
] as const;
---
<PanelLayout title="Performances" refreshMs={null}>
  <button slot="actions" type="button" class="v-btn v-btn--outline" id="perf-pause" aria-pressed="false"><Icon name="pause" size={16} /><span class="lbl">Suspendre</span></button>
  {can('processus') && (
    <a slot="actions" class="v-btn v-btn--outline" href="/processus"><Icon name="activity" size={16} />Processus</a>
  )}
  {can('reseau') && (
    <a slot="actions" class="v-btn v-btn--outline" href="/reseau"><Icon name="network" size={16} />Détail réseau</a>
  )}

  <div class="v-page v-page--wide">
    <div class="v-alert v-alert--warn" id="perf-error" role="status" hidden>
      <strong>Mesures indisponibles</strong>
      <span>Le panel n’obtient plus de réponse de /api/system/stats. Nouvelle tentative à chaque cycle.</span>
    </div>

    <div class="tm" id="tm">
      <section class="v-card" aria-label="Ressources">
        <header class="v-card__head">
          <div class="v-card__titles">
            <h2 class="v-card__title">Ressources</h2>
            <p class="v-card__desc">Choisir la mesure à tracer.</p>
          </div>
          <span class="v-status v-status--good live">En direct</span>
          <span class="v-status v-status--warning pbadge">En pause</span>
        </header>
        <div class="tm__list" role="tablist" aria-label="Ressources" aria-orientation="vertical">
          {TABS.map((t, i) => (
            <button type="button" class="tile" role="tab" id={`tab-${t.id}`} data-res={t.id}
                    aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${t.id}`} tabindex={i === 0 ? 0 : -1}>
              <canvas class="spark" data-spark={t.id} aria-hidden="true"></canvas>
              <span class="v-who">
                <span class="v-who__name">{t.name}</span>
                <span class="v-who__sub" id={`sub-${t.id}`}>{t.sub}</span>
              </span>
            </button>
          ))}
        </div>
      </section>

      <div class="tm__main">
        <div class="rpanel" id="panel-cpu" role="tabpanel" aria-labelledby="tab-cpu" data-res="cpu">
          <section class="v-card">
            <header class="v-card__head">
              <div class="v-card__titles">
                <h2 class="v-card__title ttl">Processeur</h2>
                <p class="v-card__desc">{cores} cœurs · {arch}</p>
              </div>
            </header>
            <dl class="stats">
              <div class="stat"><dt class="stat__l">Utilisation</dt><dd class="stat__v" id="cpu-use">{cpuPercent != null ? `${num(cpuPercent, 0)} %` : '-'}</dd></div>
              <div class="stat"><dt class="stat__l">Durée de fonctionnement</dt><dd class="stat__v">{duration(uptime)}</dd></div>
              <div class="stat"><dt class="stat__l">Charge moyenne (1 · 5 · 15 min)</dt><dd class="stat__v stat__v--sm" id="cpu-load">{loadLine}</dd></div>
            </dl>
            <div class="graph">
              <p class="cap"><span>% d’utilisation sur 3 minutes</span><span>100 %</span></p>
              <canvas class="big" id="cpu-graph" role="img" aria-describedby="cpu-use" aria-label="Utilisation du processeur sur 3 minutes"></canvas>
              <p class="cap"><span>3 minutes</span><span>0</span></p>
            </div>
          </section>
          <div class="duo">
            <section class="v-card">
              <header class="v-card__head"><div class="v-card__titles"><h3 class="v-card__title">Par cœur</h3></div></header>
              <div class="cores" id="cpu-cores">
                {Array.from({ length: cores }, (_, i) => (
                  <div class="core" data-core={i}>
                    <span class="core__label">Cœur {i}</span>
                    <div class="core__track"><div class="core__fill" style="width:0%"></div></div>
                    <span class="core__pct">-</span>
                  </div>
                ))}
              </div>
            </section>
            <section class="v-card">
              <header class="v-card__head"><div class="v-card__titles"><h3 class="v-card__title">Détails</h3></div></header>
              <ul class="v-list">
                {DETAILS.cpu.map((d) => (<li><span class="v-muted">{d.label}</span><span class="val" id={d.id}>{d.value}</span></li>))}
              </ul>
            </section>
          </div>
        </div>

        <div class="rpanel" id="panel-mem" role="tabpanel" aria-labelledby="tab-mem" data-res="mem" hidden>
          <section class="v-card">
            <header class="v-card__head">
              <div class="v-card__titles">
                <h2 class="v-card__title ttl">Mémoire</h2>
                <p class="v-card__desc">{mem ? `${bytes(mem.totalBytes)} installés` : ''}</p>
              </div>
            </header>
            <dl class="stats">
              <div class="stat"><dt class="stat__l">En cours d’utilisation</dt><dd class="stat__v" id="mem-used">{mem ? bytes(mem.usedBytes) : '-'}</dd></div>
              <div class="stat"><dt class="stat__l">Disponible</dt><dd class="stat__v" id="mem-avail">{mem ? bytes(mem.availableBytes) : '-'}</dd></div>
              <div class="stat"><dt class="stat__l">Utilisée</dt><dd class="stat__v" id="mem-pct">{num(memPct, 0)} %</dd></div>
              <div class="stat"><dt class="stat__l">Fichier d’échange</dt><dd class="stat__v stat__v--sm" id="mem-swap">{mem ? `${bytes(mem.swapUsedBytes)} / ${bytes(mem.swapTotalBytes)}` : '-'}</dd></div>
            </dl>
            <div class="graph">
              <p class="cap"><span>Utilisation de la mémoire</span><span>{mem ? bytes(mem.totalBytes) : '100 %'}</span></p>
              <canvas class="big" id="mem-graph" role="img" aria-describedby="mem-used" aria-label="Mémoire utilisée sur 3 minutes"></canvas>
              <p class="cap"><span>3 minutes</span><span>0</span></p>
            </div>
          </section>
          <section class="v-card">
            <header class="v-card__head"><div class="v-card__titles"><h3 class="v-card__title">Détails</h3></div></header>
            <ul class="v-list">
              {DETAILS.mem.map((d) => (<li><span class="v-muted">{d.label}</span><span class="val" id={d.id}>{d.value}</span></li>))}
            </ul>
          </section>
        </div>

        <div class="rpanel" id="panel-disk" role="tabpanel" aria-labelledby="tab-disk" data-res="disk" hidden>
          <section class="v-card">
            <header class="v-card__head">
              <div class="v-card__titles">
                <h2 class="v-card__title ttl">Disque</h2>
                <p class="v-card__desc">{disks.length > 1 ? `${disks.length} systèmes de fichiers` : disks[0]?.label ?? ''}</p>
              </div>
            </header>
            <dl class="stats">
              <div class="stat"><dt class="stat__l">Vitesse de lecture</dt><dd class="stat__v" id="disk-read">-</dd></div>
              <div class="stat"><dt class="stat__l">Vitesse d’écriture</dt><dd class="stat__v" id="disk-write">-</dd></div>
            </dl>
            <div class="graph">
              <p class="cap"><span class="keys"><span class="key"><i class="sw"></i>Lecture</span><span class="key"><i class="sw sw--dash"></i>Écriture</span></span><span id="disk-scale"></span></p>
              <canvas class="big" id="disk-graph" role="img" aria-describedby="disk-read disk-write" aria-label="Lecture et écriture disque sur 3 minutes"></canvas>
              <p class="cap"><span>3 minutes</span><span>0</span></p>
            </div>
          </section>
          <div class="duo">
            <section class="v-card">
              <header class="v-card__head"><div class="v-card__titles"><h3 class="v-card__title">Espace disque</h3></div></header>
              {disks.length === 0 ? (
                <div class="v-empty"><p class="v-empty__title">Aucun disque détecté</p></div>
              ) : (
                <ul class="v-list drives">
                  {disks.map((d: any) => {
                    const pc = percent(d.usedBytes, d.totalBytes);
                    return (
                      <li>
                        <div class="drive__top"><span class="v-who__name">{d.label}</span><span class="v-muted">{num(pc, 0)} %</span></div>
                        <div class:list={['bar', pc >= 90 && 'bar--hot']} role="progressbar" aria-label={d.label} aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(pc)}><i style={`width:${Math.max(0, Math.min(100, pc))}%`}></i></div>
                        <span class="v-who__sub">{bytes(d.freeBytes)} libres sur {bytes(d.totalBytes)}</span>
                      </li>
                    );
                  })}
                </ul>
              )}
            </section>
            <section class="v-card">
              <header class="v-card__head"><div class="v-card__titles"><h3 class="v-card__title">Détails</h3></div></header>
              <ul class="v-list">
                {DETAILS.disk.map((d) => (<li><span class="v-muted">{d.label}</span><span class="val" id={d.id}>{d.value}</span></li>))}
              </ul>
            </section>
          </div>
        </div>

        <div class="rpanel" id="panel-net" role="tabpanel" aria-labelledby="tab-net" data-res="net" hidden>
          <section class="v-card">
            <header class="v-card__head">
              <div class="v-card__titles">
                <h2 class="v-card__title ttl">Ethernet</h2>
                <p class="v-card__desc">Toutes les cartes réseau</p>
              </div>
            </header>
            <dl class="stats">
              <div class="stat"><dt class="stat__l">Réception</dt><dd class="stat__v" id="net-rx">-</dd></div>
              <div class="stat"><dt class="stat__l">Envoi</dt><dd class="stat__v" id="net-tx">-</dd></div>
            </dl>
            <div class="graph">
              <p class="cap"><span class="keys"><span class="key"><i class="sw"></i>Réception</span><span class="key"><i class="sw sw--dash"></i>Envoi</span></span><span id="net-scale"></span></p>
              <canvas class="big" id="net-graph" role="img" aria-describedby="net-rx net-tx" aria-label="Débit réseau sur 3 minutes"></canvas>
              <p class="cap"><span>3 minutes</span><span>0</span></p>
            </div>
          </section>
          <section class="v-card">
            <header class="v-card__head"><div class="v-card__titles"><h3 class="v-card__title">Détails</h3></div></header>
            <ul class="v-list">
              {DETAILS.net.map((d) => (<li><span class="v-muted">{d.label}</span><span class="val" id={d.id}>{d.value}</span></li>))}
            </ul>
          </section>
        </div>
      </div>
    </div>
  </div>
</PanelLayout>

<script>
  import { bytes } from '../server/core/format';
  import { registerCommands } from '../scripts/ui/commands';
  import { createGraph, STEP_S } from '../scripts/ui/graph';

  const rate = (n: number) => `${bytes(n)}/s`;
  const RES = ['cpu', 'mem', 'disk', 'net'] as const;
  type Res = (typeof RES)[number];

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('tm');
    if (!root) return;

    const canvas = (id: string) => document.getElementById(id) as HTMLCanvasElement;
    const spark = (r: Res) => root.querySelector(`canvas[data-spark="${r}"]`) as HTMLCanvasElement;
    const big = {
      cpu: createGraph(canvas('cpu-graph'), 'cpu', [{ name: 'Processeur' }], 'percent'),
      mem: createGraph(canvas('mem-graph'), 'mem', [{ name: 'Mémoire' }], 'percent'),
      disk: createGraph(canvas('disk-graph'), 'disk', [{ name: 'Lecture' }, { name: 'Écriture', dashed: true }], 'auto'),
      net: createGraph(canvas('net-graph'), 'net', [{ name: 'Réception' }, { name: 'Envoi', dashed: true }], 'auto'),
    };
    const mini = {
      cpu: createGraph(spark('cpu'), 'cpu', [{ name: '' }], 'percent', true),
      mem: createGraph(spark('mem'), 'mem', [{ name: '' }], 'percent', true),
      disk: createGraph(spark('disk'), 'disk', [{ name: '' }, { name: '', dashed: true }], 'auto', true),
      net: createGraph(spark('net'), 'net', [{ name: '' }, { name: '', dashed: true }], 'auto', true),
    };

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.tile'));
    function select(res: string, focus = false) {
      for (const t of tabs) {
        const on = t.dataset.res === res;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      }
      root!.querySelectorAll<HTMLElement>('.rpanel').forEach((p) => { p.hidden = p.dataset.res !== res; });
      try { sessionStorage.setItem('perf-tab', res); } catch {}
      requestAnimationFrame(() => Object.values(big).forEach((g) => g.draw()));
    }
    const tablist = root.querySelector('.tm__list')!;
    const mq = matchMedia('(max-width: 900px)');
    const orient = () => tablist.setAttribute('aria-orientation', mq.matches ? 'horizontal' : 'vertical');
    orient(); mq.addEventListener('change', orient);
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.res!)));
    root.querySelector('.tm__list')!.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(ke.key)) return;
      ke.preventDefault();
      const at = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const fwd = ke.key === 'ArrowDown' || ke.key === 'ArrowRight';
      const next = tabs[(at + (fwd ? 1 : -1) + tabs.length) % tabs.length];
      select(next.dataset.res!, true);
    });
    let saved: string | null = null;
    try { saved = sessionStorage.getItem('perf-tab'); } catch {}
    if (saved && (RES as readonly string[]).includes(saved)) select(saved);

    const HIST = 'perf-hist';
    try {
      const saved = JSON.parse(sessionStorage.getItem(HIST) || 'null');
      if (saved && Date.now() - saved.at < 60_000) {
        for (const r of RES) if (saved.data?.[r]) { big[r].seed(saved.data[r]); mini[r].seed(saved.data[r]); }
      }
    } catch {}
    const persist = () => {
      try {
        sessionStorage.setItem(HIST, JSON.stringify({ at: Date.now(), data: Object.fromEntries(RES.map((r) => [r, big[r].snapshot()])) }));
      } catch {}
    };
    const pct = (v: number | null) => (v == null ? '-' : `${Math.round(v)} %`);
    const rt = (v: number | null) => (v == null ? '-' : rate(v));
    function paintStats() {
      const c = big.cpu.stats(0), m = big.mem.stats(0), d0 = big.disk.stats(0), d1 = big.disk.stats(1), n0 = big.net.stats(0), n1 = big.net.stats(1);
      set('cpu-avg', pct(c.avg)); set('cpu-peak', pct(c.peak));
      set('mem-avg', pct(m.avg)); set('mem-peak', pct(m.peak));
      set('disk-read-avg', rt(d0.avg)); set('disk-read-peak', rt(d0.peak));
      set('disk-write-avg', rt(d1.avg)); set('disk-write-peak', rt(d1.peak));
      set('net-rx-avg', rt(n0.avg)); set('net-rx-peak', rt(n0.peak));
      set('net-tx-avg', rt(n1.avg)); set('net-tx-peak', rt(n1.peak));
    }

    const errorEl = document.getElementById('perf-error')!;
    const pauseBtn = document.getElementById('perf-pause') as HTMLButtonElement;
    let paused = false;

    function setPaused(on: boolean) {
      paused = on;
      root!.toggleAttribute('data-paused', on);
      pauseBtn.setAttribute('aria-pressed', String(on));
      pauseBtn.querySelector('.lbl')!.textContent = on ? 'Reprendre' : 'Suspendre';
      if (on && timer !== null) { clearTimeout(timer); timer = null; }
      else if (!on && timer === null && !stopped) tick().then(() => schedule());
    }
    pauseBtn.addEventListener('click', () => setPaused(!paused));

    const unregister = registerCommands([
      { id: 'perf-pause', title: 'Suspendre ou reprendre les mesures', icon: 'pause', run: () => pauseBtn.click() },
      ...RES.map((r, i) => ({
        id: `perf-${r}`, title: ['Afficher le processeur', 'Afficher la mémoire', 'Afficher le disque', 'Afficher le réseau'][i],
        icon: (['cpu', 'memory', 'hardDrive', 'network'] as const)[i], run: () => select(r),
      })),
    ]);

    const set = (id: string, text: string) => { const n = document.getElementById(id); if (n) n.textContent = text; };
    const coreEls = Array.from(root.querySelectorAll<HTMLElement>('#cpu-cores .core'));

    let stopped = false;
    let timer: number | null = null;

    async function tick() {
      if (stopped) return;
      try {
        const res = await fetch('/api/system/stats', { cache: 'no-store' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const s = await res.json();
        errorEl.hidden = true;

        if (s.cpu?.percent != null) {
          const v = [s.cpu.percent];
          big.cpu.push(v); mini.cpu.push(v);
          set('cpu-use', `${Math.round(s.cpu.percent)} %`);
          set('sub-cpu', `${Math.round(s.cpu.percent)} %`);
        }
        if (Array.isArray(s.cpu?.perCore)) {
          s.cpu.perCore.forEach((v: number | null, i: number) => {
            const core = coreEls[i];
            if (!core) return;
            const pct = v ?? 0;
            (core.querySelector('.core__fill') as HTMLElement).style.width = `${Math.max(0, Math.min(100, pct))}%`;
            core.querySelector('.core__pct')!.textContent = v == null ? '-' : `${Math.round(pct)} %`;
          });
        }
        if (s.load) set('cpu-load', s.load.map((l: number) => l.toFixed(2).replace('.', ',')).join(' · '));

        if (s.memory?.totalBytes) {
          const m = s.memory;
          const pct = (m.usedBytes / m.totalBytes) * 100;
          big.mem.push([pct]); mini.mem.push([pct]);
          set('mem-used', bytes(m.usedBytes));
          set('mem-avail', bytes(m.availableBytes));
          set('mem-swap', `${bytes(m.swapUsedBytes)} / ${bytes(m.swapTotalBytes)}`);
          set('mem-pct', `${Math.round(pct)} %`);
          set('sub-mem', `${bytes(m.usedBytes)} / ${bytes(m.totalBytes)} (${Math.round(pct)} %)`);
        }

        if (s.diskIo) {
          const v = [s.diskIo.readBytesPerSec, s.diskIo.writeBytesPerSec];
          big.disk.push(v); mini.disk.push(v);
          set('disk-read', rate(v[0]));
          set('disk-write', rate(v[1]));
          set('disk-scale', rate(big.disk.max()));
          set('sub-disk', `Lecture ${rate(v[0])} · Écriture ${rate(v[1])}`);
        }

        if (s.network) {
          const v = [s.network.rxBytesPerSec, s.network.txBytesPerSec];
          big.net.push(v); mini.net.push(v);
          set('net-rx', rate(v[0]));
          set('net-tx', rate(v[1]));
          set('net-scale', rate(big.net.max()));
          set('sub-net', `Réception ${rate(v[0])} · Envoi ${rate(v[1])}`);
        }
        paintStats();
        persist();
      } catch {
        errorEl.hidden = false;
      }
    }

    function schedule(wait = STEP_S * 1000) {
      timer = window.setTimeout(async () => {
        const t0 = performance.now();
        await tick();
        if (!paused && !stopped) schedule(Math.max(0, STEP_S * 1000 - (performance.now() - t0)));
      }, wait);
    }
    tick().then(() => schedule());

    document.addEventListener('astro:before-swap', () => {
      stopped = true;
      unregister();
      if (timer !== null) clearTimeout(timer);
      [...Object.values(big), ...Object.values(mini)].forEach((g) => g.stop());
    }, { once: true });
  });
</script>

<style>
  .tm { display: grid; grid-template-columns: 20rem minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .tm > .v-card { position: sticky; top: 1rem; }
  .tm__main, .rpanel { display: flex; flex-direction: column; gap: 1.5rem; min-width: 0; }
  .rpanel[hidden], .v-alert[hidden] { display: none; }
  .duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr)); gap: 1.5rem; }
  .duo > .v-card { min-width: 0; }

  /* Couleur de série par ressource */
  [data-res='cpu']  { --c: var(--res-cpu); }
  [data-res='mem']  { --c: var(--res-mem); }
  [data-res='disk'] { --c: var(--res-disk); }
  [data-res='net']  { --c: var(--res-net); }

