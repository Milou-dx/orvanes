---
import AuthLayout from '../layouts/AuthLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { PENDING_COOKIE, googleConfigured } from '../server/auth/auth';
import { firstAllowedPage, tabs } from '../server/auth/auth-core.js';

export const prerender = false;

const user = Astro.locals.user;

if (!Astro.locals.authEnabled) return Astro.redirect('/');

const etat = Astro.url.searchParams.get('etat');
const suite = Astro.url.searchParams.get('suite') ?? '';
if (user?.status === 'active' && !etat) return Astro.redirect(firstAllowedPage(user) ?? '/connexion?etat=aucun');

const googleOn = googleConfigured();
const googleHref = `/api/auth/google/start${suite ? `?suite=${encodeURIComponent(suite)}` : ''}`;
const ERREURS: Record<string, string> = { google: 'Connexion Google impossible.', refus: 'Google a refusé la connexion.', bloque: 'Le panel a bloqué ce compte.', trop: 'Trop de tentatives : réessayez dans quelques minutes.' };
const erreurMessage = ERREURS[Astro.url.searchParams.get('erreur') ?? ''] ?? '';
const refusedTab = tabs().find((t) => t.pages.some((p) => Astro.url.searchParams.get('onglet')?.startsWith(p) && p !== '/'));
const home = user ? firstAllowedPage(user) : null;

let who: { name?: string; email?: string; picture?: string } | null = null;
try {
  const raw = Astro.cookies.get(PENDING_COOKIE)?.value;
  if (raw) who = JSON.parse(Buffer.from(raw, 'base64url').toString('utf8'));
} catch {}
if (who?.picture && !/^https:\/\/[a-z0-9-]+\.googleusercontent\.com\//i.test(who.picture)) who.picture = '';
const initial = String(who?.name || who?.email || '?').trim().charAt(0).toUpperCase();
---
<AuthLayout title="Connexion">
  {!['attente', 'refuse', 'aucun'].includes(etat ?? '') && (
    <>
      <h1 class="visually-hidden">Connexion</h1>
      <form id="login-form" class="auth__form" autocomplete="on" novalidate>
        <div class="field" style="--i:0">
          <input id="f-id" name="identifier" type="text" autocomplete="username" required autocapitalize="none" spellcheck="false" placeholder=" " aria-describedby="login-error" />
          <label for="f-id">Identifiant</label>
        </div>
        <div class="field" style="--i:1">
          <input id="f-pw" name="password" type="password" autocomplete="current-password" required placeholder=" " aria-describedby="login-error" />
          <label for="f-pw">Mot de passe</label>
        </div>
        <p class="auth__error" id="login-error" role="alert">{erreurMessage}</p>
        <button type="submit" class="go" id="login-btn" style="--i:2">
          <span class="go__fill"></span>
          <span class="go__label">Se connecter</span>
          <Icon name="arrowRight" size={20} class="go__arrow" />
          <span class="go__spin"></span>
        </button>
      </form>

      {googleOn && (
        <div id="google-start" class="auth__alt" style="--i:3">
          <a class="bubble" href={googleHref} aria-label="Se connecter avec Google" data-tip="Google">
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path fill="#4285F4" d="M17.64 9.2045c0-.6381-.0573-1.2518-.1636-1.8409H9v3.4814h4.8436c-.2086 1.125-.8427 2.0782-1.7959 2.7164v2.2581h2.9087c1.7018-1.5668 2.6836-3.874 2.6836-6.615z"/>
            <path fill="#34A853" d="M9 18c2.43 0 4.4673-.806 5.9564-2.1805l-2.9087-2.2581c-.8059.54-1.8368.859-3.0477.859-2.344 0-4.3282-1.5831-5.036-3.7104H.9574v2.3318C2.4382 15.9832 5.4818 18 9 18z"/>
            <path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.2822-1.1168-.2822-1.71s.1023-1.17.2823-1.71V4.9582H.9573A8.9965 8.9965 0 0 0 0 9c0 1.4523.3477 2.8268.9573 4.0418L3.964 10.71z"/>
            <path fill="#EA4335" d="M9 3.5795c1.3214 0 2.5077.4541 3.4405 1.346l2.5813-2.5814C13.4632.8918 11.426 0 9 0 5.4818 0 2.4382 2.0168.9573 4.9582L3.964 7.29C4.6718 5.1627 6.6559 3.5795 9 3.5795z"/>
          </svg>
            </a>
        </div>
      )}
      <input type="hidden" id="suite" value={suite} />
    </>
  )}

  {etat === 'attente' && (
    <div class="wait">
      <div class="wait__avatar">
        <span class="wait__ring"></span>
        {who?.picture
          ? <img class="wait__img" src={who.picture} alt="" width="68" height="68" referrerpolicy="no-referrer" />
          : <span class="wait__img wait__initial" aria-hidden="true">{initial}</span>}
        <span class="wait__badge"><Icon name="clock" size={16} /></span>
      </div>
      <h1 class="wait__title">Demande envoyée</h1>
      <p class="wait__text">L’administrateur va examiner votre demande d’accès. Vous pourrez vous connecter dès que l’administrateur l’aura acceptée.</p>
      {who?.email && <p class="wait__who">{who.email}</p>}
      <ol class="wait__steps">
        <li class="is-done"><span class="wait__dot"><Icon name="check" size={16} /></span>Demande reçue</li>
        <li class="is-now" aria-current="step"><span class="wait__dot"></span>Examen par l’administrateur</li>
        <li><span class="wait__dot"></span>Accès accordé</li>
      </ol>
      <button type="button" class="auth__btn wait__back" data-logout>Retour à la connexion</button>
    </div>
  )}

  {etat === 'refuse' && (
    <>
      <h1 class="auth__title">Accès refusé</h1>
      <p class="auth__lead">{refusedTab
        ? <>Votre compte n’a pas accès à l’onglet <strong>{refusedTab.label}</strong>. Demandez-le à un administrateur.</>
        : 'Cette page n’existe pas ou seuls les administrateurs y accèdent.'}</p>
      {home && <a class="auth__btn auth__btn--primary" href={home}>Retour à mes onglets</a>}
      <button type="button" class="auth__btn" data-logout>Se déconnecter</button>
    </>
  )}

  {etat === 'aucun' && (
    <>
      <h1 class="auth__title">Aucun onglet attribué</h1>
      <p class="auth__lead">Votre compte est actif, sans onglet attribué. Contactez l’administrateur.</p>
      <button type="button" class="auth__btn" data-logout>Se déconnecter</button>
    </>
  )}
</AuthLayout>

<script>
  import '../scripts/pages/connexion';
</script>
