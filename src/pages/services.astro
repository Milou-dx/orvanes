---
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/vault.css';
import type { IconName } from '../components/ui/lucide';
import { toStatus } from '../components/ui/status';
import * as svc from '../server/system/services.js';

/** Recomposé avec les blocs du Vault (dashboardblocks, MIT) : stat-group-01 (chiffres), status-01 (services importants), data-table-01 (liste), dashboard-header (filtres). */
export const prerender = false;

let all: any[] = [];
let failure = '';
try { all = await svc.listServices(); } catch (e: any) { failure = e?.message ?? 'Lecture impossible'; }

const running = all.filter((s) => s.active === 'active');
const nStopped = all.filter((s) => toStatus(s.active) === 'stopped').length;
const nError = all.filter((s) => toStatus(s.active) === 'error').length;
const nBoot = all.filter((s) => s.enabled === 'enabled' || s.enabled === 'enabled-runtime').length;

const PROTECTED = svc.protectedUnits().map((p) => p.unit);

const rows = all.map((s) => ({
  name: s.name,
  description: s.description ?? '',
  active: s.active,
  sub: s.sub ?? '',
  enabled: s.enabled ?? 'unknown',
  pid: s.pid ?? null,
  state: toStatus(s.active),
}));
const data = JSON.stringify({ rows, protectedUnits: PROTECTED }).replace(/</g, '\\u003c');

const KEY: { unit: string; label: string; desc: string; icon: IconName }[] = [
  { unit: 'ssh',        label: 'Accès SSH',          desc: 'Connexion à distance au serveur', icon: 'terminal' },
  { unit: 'tailscaled', label: 'Tailscale',          desc: 'Réseau privé entre vos appareils', icon: 'waypoints' },
  { unit: 'cron',       label: 'Tâches planifiées',  desc: 'Exécution périodique (cron)', icon: 'clock' },
];
const keyServices = KEY.map((k) => ({ ...k, s: all.find((x) => x.name === k.unit) })).filter((k) => k.s);
const isProtected = (u: string) => PROTECTED.includes(u);

const TONE: Record<string, string> = { running: 'good', warning: 'warning', error: 'bad' };
const tone = (raw: string) => TONE[toStatus(raw)];
const label = (raw: string) => (raw === 'active' ? 'Actif' : raw === 'failed' ? 'Échec' : raw === 'inactive' ? 'Inactif' : raw);
const down = keyServices.filter((k) => k.s.active !== 'active');
const keySummary = down.length === 0
  ? `Les ${keyServices.length} services importants fonctionnent.`
  : `À l’arrêt ou en échec : ${down.map((k) => k.label).join(', ')}.`;
const keyTone = down.length === 0 ? 'good' : 'bad';
const keyHeadline = down.length === 0 ? 'Tout fonctionne' : `${down.length} à vérifier`;
const stats: { label: string; value: number; note: string; tone?: string }[] = [
  { label: 'Actifs', value: running.length, note: `sur ${all.length} services` },
  { label: 'Arrêtés', value: nStopped, note: 'inactifs ou terminés' },
  { label: 'En échec', value: nError, note: nError ? 'à examiner dans les journaux' : 'aucun échec', tone: nError ? 'bad' : undefined },
  { label: 'Au démarrage', value: nBoot, note: 'lancés avec le serveur' },
];
---
<PanelLayout title="Services" subtitle={failure ? undefined : `${running.length} actifs sur ${all.length}`}>
  {failure ? (
    <div class="v-page v-page--wide">
      <div class="v-alert v-alert--warn" role="alert">
        <strong>Impossible de lire les services</strong>
        <span>systemd n’a pas répondu. Réessayez dans un instant.</span>
        <pre class="v-code">{failure}</pre>
      </div>
    </div>
  ) : (
    <div id="svc-root" class="v-page v-page--wide">
      <section class="v-card" aria-label="Résumé des services">
        <div class="stats">
          {stats.map((st) => (
            <div class="stat">
              <span class="stat__l">{st.label}</span>
              <span class:list={['stat__v', st.tone && `stat__v--${st.tone}`]}>{st.value}</span>
              <span class="stat__c">{st.note}</span>
            </div>
          ))}
        </div>
      </section>

      {keyServices.length > 0 && (
        <section class="v-card">
          <header class="v-card__head">
            <div class="v-card__titles">
              <span class={`v-status v-status--${keyTone}`}>{keyHeadline}</span>
              <h2 class="v-card__title">Services importants</h2>
              <p class="v-card__desc">{keySummary}</p>
            </div>
          </header>
          <ul class="v-list">
            {keyServices.map((k) => (
              <li>
                <span class="v-avatar"><Icon name={k.icon} size={16} /></span>
                <div class="v-who">
                  <span class="v-who__name">{k.label}</span>
                  <span class="v-who__sub">{k.desc}</span>
                </div>
                <span class:list={['v-status', tone(k.s.active) && `v-status--${tone(k.s.active)}`]}>{label(k.s.active)}</span>
                {!isProtected(k.unit) && (k.s.active === 'active'
                  ? <button type="button" class="v-btn v-btn--sm v-btn--outline svc-act svc-act--restart" data-unit={k.unit} data-action="restart" aria-label={`Redémarrer ${k.unit}`} title="Redémarrer"><span class="svc-act__i"><Icon name="restart" size={16} /></span><span class="svc-act__t">Redémarrer</span></button>
                  : <button type="button" class="v-btn v-btn--sm v-btn--outline svc-act svc-act--start" data-unit={k.unit} data-action="start" aria-label={`Démarrer ${k.unit}`} title="Démarrer"><span class="svc-act__i"><Icon name="play" size={16} /></span><span class="svc-act__t">Démarrer</span></button>)}
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="v-card">
        <header class="v-card__head">
          <div class="v-card__titles">
            <h2 class="v-card__title">Tous les services</h2>
            <p class="v-card__desc">Services systemd du serveur. Arrêtez, démarrez ou redémarrez chacun depuis sa ligne.</p>
          </div>
        </header>
        <div class="v-toolbar" role="group" aria-label="Filtres des services">
          <input class="v-input" type="search" id="svc-search" placeholder="Rechercher un service" aria-label="Rechercher un service"
                 autocomplete="off" spellcheck="false" data-table-filter="svc" aria-controls="svc-table" data-search-target />
          <div class="v-tabs" id="svc-states" role="group" aria-label="Filtrer par état">
            <button type="button" class="v-tab" data-state="all" aria-pressed="true">Tous <span class="v-tag" data-n="all">{all.length}</span></button>
            <button type="button" class="v-tab" data-state="running" aria-pressed="false">En cours <span class="v-tag" data-n="running">{running.length}</span></button>
            <button type="button" class="v-tab" data-state="stopped" aria-pressed="false">Arrêtés <span class="v-tag" data-n="stopped">{nStopped}</span></button>
            <button type="button" class="v-tab" data-state="error" aria-pressed="false">En échec <span class="v-tag" data-n="error">{nError}</span></button>
          </div>
        </div>
        <div id="svc" class="v-table-wrap" data-dt="svc" data-dt-client data-noun="service|services" data-skeleton="5">
          <table class="v-table" id="svc-table" aria-busy="true">
            <caption class="visually-hidden">Services systemd</caption>
            <thead><tr></tr></thead>
            <tbody></tbody>
          </table>
        </div>
        <p class="v-card__foot" data-table-count="svc" aria-live="polite"></p>
      </section>
      <script is:inline type="application/json" id="svc-data" set:html={data}></script>
    </div>
  )}
</PanelLayout>

<script>
  import '../scripts/pages/services';
</script>

<style>
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.5rem 0; }
  .v-card > .stats { padding-inline: 0; }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; padding-inline: 1.5rem; min-width: 0; }
  .stat + .stat { border-left: 1px solid var(--border); }
  .stat__l { font-size: 0.875rem; color: var(--text-secondary); }
  .stat__v { font-size: 2rem; line-height: 1.1; font-weight: 300; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--text-primary); }
  .stat__v--bad { color: var(--danger); }
  .stat__c { font-size: 0.75rem; color: var(--text-secondary); }
  .v-card > .v-table-wrap { padding-inline: 0; border-top: 1px solid var(--border); margin-top: -0.5rem; }
  .v-card > .v-toolbar { padding-block: 0; }
  .v-toolbar .v-tabs { height: 2.25rem; }
  .v-tab :global(.v-tag) { margin-left: 0.125rem; }

  /* Lignes de tableau générées par scripts/ui/table.ts */
  :global(#svc .v-table td.is-mono) { font-family: var(--font-mono); font-size: 0.8125rem; font-variant-ligatures: none; }
  :global(#svc .v-table td.is-muted) { color: var(--text-secondary); }
  :global(#svc .v-table td.is-nowrap) { white-space: nowrap; }
  :global(#svc .v-table th.al-right), :global(#svc .v-table td.al-right) { text-align: right; }
  :global(#svc .v-table td.is-actions) { width: 1%; white-space: nowrap; text-align: right; }
  :global(#svc .dt__actions) { display: inline-flex; align-items: center; justify-content: flex-end; gap: 0.375rem; }
  :global(#svc .dt__sort) { display: inline-flex; align-items: center; gap: 0.25rem; margin: 0 -0.25rem; padding: 0.125rem 0.25rem; border: 0; border-radius: 0.375rem; background: transparent; color: inherit; font: inherit; cursor: pointer; white-space: nowrap; }
  :global(#svc .al-right > .dt__sort) { flex-direction: row-reverse; }
  :global(#svc .dt__sort:hover) { background: var(--bg-hover); color: var(--text-primary); }
  :global(#svc .dt__arrow) { width: 0.75rem; height: 0.75rem; opacity: 0; transition: opacity 150ms, transform 150ms; }
  :global(#svc .dt__sort:hover .dt__arrow), :global(#svc .dt__sort:focus-visible .dt__arrow) { opacity: 0.6; }
  :global(#svc th[aria-sort] .dt__sort) { color: var(--text-primary); }
  :global(#svc th[aria-sort] .dt__arrow) { opacity: 1; color: var(--accent-text); }
  :global(#svc th[aria-sort='descending'] .dt__arrow) { transform: rotate(180deg); }
  :global(#svc .dt__state td) { padding: 0; }
  :global(#svc .dt__state:hover) { background: transparent; }
  :global(#svc .ui-state) { display: grid; justify-items: center; gap: 0.5rem; padding: 2.5rem 1rem; text-align: center; }
  :global(#svc .ui-state__icon) { color: var(--text-secondary); }
  :global(#svc .ui-state__title) { margin: 0; font-size: 0.875rem; font-weight: 500; color: var(--text-primary); }
  :global(#svc .ui-state__text) { margin: 0; max-width: 36ch; font-size: 0.875rem; color: var(--text-secondary); }
  :global(#svc .dt__skel td) { height: 2.75rem; }
  @media (max-width: 1200px) { :global(#svc .hide-lg) { display: none; } }

  /* Boutons d'action (lignes générées par le script et services importants) */
  :global(.svc-act:disabled) { cursor: not-allowed; }
  :global(.svc-act__i) { display: inline-grid; place-items: center; }
  :global(.svc-act[aria-busy='true'] svg) { display: none; }
  :global(.svc-act[aria-busy='true'] .svc-act__i::before) {
    content: ''; width: 0.75rem; height: 0.75rem; border-radius: 50%;
    border: 2px solid currentColor; border-right-color: transparent; animation: n-spin 0.7s linear infinite;
  }
  @media (max-width: 900px) {
    :global(.svc-act) { position: relative; }
    :global(.svc-act__t) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    :global(.svc-act) { padding: 0; width: 2rem; }
  }
  @media (pointer: coarse) { :global(.svc-act) { min-width: 44px; min-height: 44px; } }
  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .stat, .stat + .stat { border-left: 0; padding-inline: 1rem; }
  }
</style>
