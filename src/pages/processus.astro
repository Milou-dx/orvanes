---
import PanelLayout from '../layouts/PanelLayout.astro';
import Icon from '../components/ui/Icon.astro';
import '../styles/vault.css';
import os from 'node:os';
import { tabAllowed } from '../layouts/nav';

/** Recomposé avec les blocs du Vault (dashboardblocks, MIT) : stat-group-01 (chiffres clés), leaderboard-05 (plus gourmands), metric-list-03 (barres), data-table-01 (liste), dashboard-header (filtres). */
export const prerender = false;

const cores = os.cpus().length || 1;
const panelUser = os.userInfo().username;
const canTerminal = tabAllowed(Astro.locals)('terminal');
---
<PanelLayout title="Processus" refreshMs={null}>
  {canTerminal && <a slot="actions" class="v-btn v-btn--outline" href="/terminal"><Icon name="terminal" size={16} />Ouvrir le terminal</a>}
  <button slot="actions" type="button" class="v-btn v-btn--outline v-btn--danger" id="pm-end" disabled><Icon name="dismiss" size={16} />Fin de tâche</button>

  <div id="pm-root" class="v-page v-page--wide" data-cores={cores} data-user={panelUser}>
    <div class="v-alert v-alert--warn" id="pm-stale" role="status" hidden>
      <strong>Données non actualisées</strong>
      <span>Nouvelle tentative en cours.</span>
    </div>

    <section class="v-card" aria-label="Résumé des processus">
      <div class="stats">
        <div class="stat">
          <span class="stat__l">Processeur</span>
          <strong class="stat__v" id="pm-cpu">-</strong>
          <span class="pm-meter" aria-hidden="true"><i id="pm-cpu-bar"></i></span>
          <span class="stat__c">{`sur ${cores} ${cores > 1 ? 'cœurs' : 'cœur'}`}</span>
        </div>
        <div class="stat">
          <span class="stat__l">Mémoire</span>
          <strong class="stat__v" id="pm-mem">-</strong>
          <span class="pm-meter" aria-hidden="true"><i id="pm-mem-bar"></i></span>
          <span class="stat__c">utilisée par les processus</span>
        </div>
        <div class="stat">
          <span class="stat__l">Processus</span>
          <strong class="stat__v" id="pm-count">-</strong>
          <span class="stat__c" id="pm-run">en cours d’exécution</span>
        </div>
        <div class="stat">
          <span class="stat__l">Plus gourmand</span>
          <strong class="stat__v stat__v--txt" id="pm-top">-</strong>
          <span class="stat__c" id="pm-top-note">en processeur</span>
        </div>
      </div>
    </section>

    <div class="pm-grid">
      <section class="v-card">
        <header class="v-card__head">
          <div class="v-card__titles">
            <h2 class="v-card__title">Tous les processus</h2>
            <p class="v-card__desc">Triez par colonne, groupez par nom, ou ouvrez le menu d’une ligne pour terminer un processus.</p>
          </div>
        </header>
        <div class="v-toolbar" role="group" aria-label="Filtres des processus">
          <input class="v-input" type="search" id="pm-search" placeholder="Rechercher un nom, un utilisateur ou un PID" aria-label="Rechercher un nom, un utilisateur ou un PID"
                 autocomplete="off" spellcheck="false" data-table-filter="pm" aria-controls="pm-table" data-search-target />
          <select class="v-select" id="pm-user" aria-label="Filtrer par utilisateur">
            <option value="">Tous les utilisateurs</option>
            <option value="system">SYSTÈME</option>
            <option value="user">Panel</option>
            <option value="other">Autres comptes</option>
          </select>
          <button type="button" class="v-btn v-btn--sm v-btn--outline" id="pm-group" aria-pressed="false"><Icon name="layers" size={16} />Grouper par nom</button>
          <button type="button" class="v-btn v-btn--sm v-btn--outline pm-refresh" id="pm-refresh"><Icon name="refresh" size={16} />Actualiser</button>
        </div>
        <div id="pm" class="v-table-wrap" data-dt="pm" data-dt-client data-noun="processus|processus" data-skeleton="10">
          <table class="v-table" id="pm-table" aria-busy="true">
            <caption class="visually-hidden">Processus en cours d’exécution</caption>
            <thead><tr></tr></thead>
            <tbody></tbody>
          </table>
        </div>
        <p class="v-card__foot" data-table-count="pm" aria-live="polite"></p>
      </section>

      <div class="pm-side">
        <section class="v-card" aria-label="Plus gros consommateurs">
          <header class="v-card__head">
            <div class="v-card__titles">
              <h2 class="v-card__title">Les plus gourmands</h2>
              <p class="v-card__desc">Cinq noms de processus en tête, regroupés.</p>
            </div>
          </header>
          <div class="v-toolbar">
            <div class="v-tabs" id="pm-top-by" role="group" aria-label="Classer par">
              <button type="button" class="v-tab" data-by="cpu" aria-pressed="true">Processeur</button>
              <button type="button" class="v-tab" data-by="mem" aria-pressed="false">Mémoire</button>
            </div>
          </div>
          <ul class="v-list" id="pm-lb" aria-live="off"></ul>
        </section>

        <aside class="v-card" aria-label="Détails du processus">
          <header class="v-card__head">
            <div class="v-card__titles">
              <h2 class="v-card__title">Détails</h2>
            </div>
          </header>
          <div id="pm-detail-body">
            <div class="v-empty">
              <p class="v-empty__title">Aucun processus sélectionné</p>
              <p class="v-empty__text"><kbd class="pm-kbd">Suppr</kbd> termine la sélection, clic droit ou touche Menu pour les autres actions.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>

</PanelLayout>

<script>
  import '../scripts/pages/processus';
</script>

<style>
  .pm-grid { display: grid; grid-template-columns: minmax(0, 1fr) 21rem; gap: 1.5rem; align-items: start; }
  .pm-side { position: sticky; top: 1rem; display: flex; flex-direction: column; gap: 1.5rem; min-width: 0; }
  .v-alert[hidden] { display: none; }

  /* stat-group-01 */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1.5rem 0; }
  .v-card > .stats { padding-inline: 0; }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; padding-inline: 1.5rem; min-width: 0; }
  .stat + .stat { border-left: 1px solid var(--border); }
  .stat__l { font-size: 0.875rem; color: var(--text-secondary); }
  .stat__v { font-size: 2rem; line-height: 1.1; font-weight: 300; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--text-primary); }
  .stat__v--txt { font-size: 1.375rem; line-height: 1.6; font-weight: 500; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stat__c { font-size: 0.75rem; color: var(--text-secondary); }
  /* metric-list-03 : barre fine */
  .pm-meter { display: block; height: 0.375rem; border-radius: 999px; background: var(--bg-hover); overflow: hidden; }
  .pm-meter > i { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--accent); transition: width 400ms ease; }

  /* tableau (data-table-01) */
  .v-card > .v-table-wrap { padding-inline: 0; border-top: 1px solid var(--border); margin-top: -0.5rem; }
  .v-card > .v-toolbar { padding-block: 0; }
  .v-toolbar > .v-select { flex: none; }
  .v-toolbar .pm-refresh { margin-left: auto; }
  #pm-group[aria-pressed='true'] { background: var(--accent-subtle); border-color: var(--accent); color: var(--accent-text); }
  #pm.v-table-wrap { max-height: 640px; overflow: auto; }
  #pm .v-table thead :global(th) { position: sticky; top: 0; z-index: 1; background: var(--bg-surface); }
  .v-card__foot:empty { display: none; }
  .pm-kbd { padding: 0 0.3rem; border: 1px solid var(--border); border-radius: 0.25rem; font: 0.75rem var(--font-mono); }

  /* leaderboard-05 : barre derrière la ligne */
  #pm-lb > :global(li) { position: relative; isolation: isolate; padding-inline: 0.5rem; }
  #pm-lb > :global(li)::before { content: ''; position: absolute; inset: 0.125rem 0; width: var(--v, 0); z-index: -1; border-radius: 0.375rem; background: color-mix(in srgb, var(--accent) 20%, transparent); transition: width 400ms ease; }
  #pm-lb > :global(li):first-child::before { background: color-mix(in srgb, var(--accent) 32%, transparent); }
  #pm-lb :global(.pm-rk) { width: 1.25rem; text-align: center; font-size: 0.75rem; font-variant-numeric: tabular-nums; color: var(--text-secondary); }
  #pm-lb :global(.pm-lb__v) { min-width: 3.5rem; font-size: 0.8125rem; }

  /* détail du processus */
  #pm-detail-body :global(.pm-d__id) { display: flex; align-items: center; gap: 0.75rem; padding-bottom: 1rem; }
  #pm-detail-body :global(.pm-d__name) { overflow-wrap: anywhere; white-space: normal; }
  #pm-detail-body :global(.v-list > li) { align-items: baseline; justify-content: space-between; }
  #pm-detail-body :global(.pm-d__v) { min-width: 0; font-size: 0.875rem; overflow-wrap: anywhere; text-align: right; }
  #pm-detail-body :global(.pm-d__actions) { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 1rem; }

  /* lignes générées par scripts/ui/table.ts et pm */
  :global(#pm .v-table td.is-mono) { font-family: var(--font-mono); font-size: 0.8125rem; font-variant-ligatures: none; }
  :global(#pm .v-table td.is-muted) { color: var(--text-secondary); }
  :global(#pm .v-table td.is-nowrap) { white-space: nowrap; }
  :global(#pm .v-table th.al-right), :global(#pm .v-table td.al-right) { text-align: right; }
  :global(#pm .v-table td.is-actions) { width: 1%; white-space: nowrap; text-align: right; }
  :global(#pm .v-table tr.is-clickable) { cursor: pointer; }
  :global(#pm .v-table tr.is-clickable:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
  :global(#pm .pm-n) { color: var(--text-secondary); }
  :global(#pm tr.pm-sel td) { background: var(--accent-subtle); }
  :global(#pm td.pm-heat) { position: relative; padding-bottom: 0.875rem; font-variant-numeric: tabular-nums; }
  :global(#pm td.pm-heat::after) {
    content: ''; position: absolute; left: 0.5rem; right: 0.5rem; bottom: 0.3125rem; height: 3px; border-radius: 2px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--danger) calc(var(--h) * 100%), var(--accent)) calc(var(--h) * 100%), var(--bg-hover) 0);
  }
  :global(#pm .dt__sort) { display: inline-flex; align-items: center; gap: 0.25rem; margin: 0 -0.25rem; padding: 0.125rem 0.25rem; border: 0; border-radius: 0.375rem; background: transparent; color: inherit; font: inherit; cursor: pointer; white-space: nowrap; }
  :global(#pm .al-right > .dt__sort) { flex-direction: row-reverse; }
  :global(#pm .dt__sort:hover) { background: var(--bg-hover); color: var(--text-primary); }
  :global(#pm .dt__arrow) { width: 0.75rem; height: 0.75rem; opacity: 0; transition: opacity 150ms, transform 150ms; }
  :global(#pm .dt__sort:hover .dt__arrow), :global(#pm .dt__sort:focus-visible .dt__arrow) { opacity: 0.6; }
  :global(#pm th[aria-sort] .dt__sort) { color: var(--text-primary); }
  :global(#pm th[aria-sort] .dt__arrow) { opacity: 1; color: var(--accent-text); }
  :global(#pm th[aria-sort='descending'] .dt__arrow) { transform: rotate(180deg); }
  :global(#pm .dt__state td) { padding: 0; }
  :global(#pm .dt__state:hover) { background: transparent; }
  :global(#pm .ui-state) { display: grid; justify-items: center; gap: 0.5rem; padding: 2.5rem 1rem; text-align: center; }
  :global(#pm .ui-state__icon) { color: var(--text-secondary); }
  :global(#pm .ui-state__title) { margin: 0; font-size: 0.875rem; font-weight: 500; color: var(--text-primary); }
  :global(#pm .ui-state__text) { margin: 0; max-width: 36ch; font-size: 0.875rem; color: var(--text-secondary); }
  :global(#pm .ui-state__detail) { margin: 0; max-width: 100%; overflow: auto; font: 0.75rem var(--font-mono); color: var(--text-secondary); }
  :global(#pm .dt__skel td) { height: 2.5rem; }
  @media (max-width: 1200px) { :global(#pm .hide-lg) { display: none; } }

  @media (max-width: 1200px) {
    .pm-grid { grid-template-columns: minmax(0, 1fr); }
    .pm-side { position: static; }
  }
  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .stat, .stat + .stat { border-left: 0; padding-inline: 1rem; }
  }
</style>
