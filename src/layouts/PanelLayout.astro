---
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/ui/Icon.astro';
import Sym from '../components/ui/Sym.astro';
import Kbd from '../components/ui/Kbd.astro';
import ModuleLogo from '../components/ui/ModuleLogo.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { GLYPHS, type IconName } from '../components/ui/glyphs';
import { PANEL_MARK } from '../components/ui/icons';
import { WALLPAPER } from '../components/ui/wallpaper';
import { PANEL_NAME } from '../server/core/panel';
import { SECTIONS, buildNav, currentItem, visibleTabs, type NavItem } from './nav';
import '../styles/inter-latin.css';
import '../styles/global.css';
import '../styles/ui.css';

interface Props {
  title: string;
  subtitle?: string;
  refreshMs?: number | null;
  favicon?: string;
  bare?: boolean;
}
const { title, subtitle, refreshMs = 3_000, favicon: faviconProp, bare = false } = Astro.props;

const SPRITE: IconName[] = ['chevronRight'];

const user = Astro.locals.user;
const authOn = Astro.locals.authEnabled;
const NAV = await buildNav(visibleTabs(authOn, user));

const path = Astro.url.pathname;
const page = currentItem(NAV, path);
const isCurrent = (item: NavItem) => item === page;
const section = SECTIONS.find((s) => s.id === page?.sec && s.label !== page?.label);
const logoKey = 'panel';
const ICON_V = 8;
const favicon = faviconProp ?? `/icons/${logoKey}.svg?v=${ICON_V}`;
---
<!doctype html>
<html lang="fr" transition:animate="none" data-ui={bare ? 'classic' : 'notion'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="icon" type="image/png" sizes="32x32" href={`/icons/${logoKey}.png?size=32&v=${ICON_V}`} />
    <link rel="apple-touch-icon" href={`/icons/${logoKey}.png?size=180&bg=white&v=${ICON_V}`} />
    <title>{title} · {PANEL_NAME}</title>
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>
      (function () {
        function pref(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
        function apply() {
          var root = document.documentElement;
          var t = pref('panel-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          root.setAttribute('data-theme', t);
          root.style.setProperty('--pulse-phase', -(Date.now() % 2000) + 'ms');
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
        window.__applyPanelPrefs = apply;
        var root = document.documentElement;
        if (root.getAttribute('data-ui') === 'notion' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.setAttribute('data-enter', '');
          setTimeout(function () { root.removeAttribute('data-enter'); }, 900);
        }
      })();
    </script>
    <meta name="orvane-build" content={import.meta.env.BUILD_ID} />
    <ClientRouter />
  </head>
  <body data-refresh={refreshMs ?? undefined}>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      {SPRITE.map((n) => <symbol id={`ic-${n}`} viewBox="0 0 256 256" set:html={GLYPHS[n]} />)}
    </svg>

    <div class="window wallpaper" style={WALLPAPER}>
      <header class="topbar" transition:name="titlebar">
        <div class="topbar__left">
          <nav class="capsule spaces on-island" aria-label="Sections">
            {SECTIONS.filter((s) => NAV.some((i) => i.sec === s.id)).map((s) => (
              <a class="space" href={NAV.find((i) => i.sec === s.id)!.href} title={s.label} aria-label={s.label}
                 aria-current={page?.sec === s.id ? 'true' : undefined} data-astro-prefetch="hover"></a>
            ))}
          </nav>
        </div>

        <button type="button" class="island on-island" data-cmdk-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K"
                aria-label="Rechercher une page ou une action" data-processus={NAV.some((i) => i.tab === 'processus') ? '' : undefined}>
          <Icon name="search" size={16} />
          <span class="island__txt">Rechercher…</span>
          <Kbd keys="Mod+K" class="island__keys" />
        </button>

        <div class="topbar__right">
          {refreshMs && (
            <p class="refresh capsule on-island" id="refresh-state" data-idle={`Actualisation · ${Math.round(refreshMs / 1000)} s`}>
              <span class="refresh__dot" aria-hidden="true"></span>
              <span class="refresh__txt">Actualisation · {Math.round(refreshMs / 1000)} s</span>
            </p>
          )}
          <p class="capsule clock on-island" data-clock></p>
          {authOn && user && (
            <button type="button" class="account capsule on-island" data-account-menu aria-haspopup="menu" aria-expanded="false" aria-label={`Compte de ${user.name}`}
                    data-name={user.name} data-email={user.email && user.email !== user.name ? user.email : ''} data-admin={user.role === 'admin' ? '' : undefined}>
              <span class="account__avatar" aria-hidden="true">{(user.name ?? '?').trim().slice(0, 1).toUpperCase()}</span>
              <span class="account__name">{user.name}</span>
            </button>
          )}
        </div>
      </header>

      <nav class="dock" id="dock" aria-label="Navigation principale" transition:name="dock">
        <ul class="dock__row">
          {SECTIONS.filter((s) => NAV.some((i) => i.sec === s.id)).map((s, n) => (
            <>
              {n > 0 && <li class="dock__sep" role="separator"></li>}
              {NAV.filter((i) => i.sec === s.id).map((item) => (
                <li class="dock__cell">
                  <a href={item.href} class="dock__tile on-island" aria-current={isCurrent(item) ? 'page' : undefined}
                     aria-label={item.label} data-label={item.label} data-section={s.label} data-astro-prefetch="hover">
                    <span class="dock__glyph">{item.module ? <ModuleLogo id={item.module} size={24} /> : <Icon name={item.icon!} size={24} />}</span>
                    {(item.badge || item.badgeId) && <span class="dock__badge" data-badge={item.badgeId} aria-label={`${item.badge ?? 0} non lus`} hidden={!item.badge}>{item.badge ?? 0}</span>}
                  </a>
                </li>
              ))}
            </>
          ))}
        </ul>
      </nav>

      <div class="frame">
        <div class="frame__bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <nav class="crumbs" aria-label="Fil d’Ariane">
            {section && <span class="crumbs__sec">{section.label}</span>}
            {section && <Sym name="chevronRight" size={12} class="crumbs__sep" />}
            {page && path !== page.href ? (
              <>
                <a class="crumbs__link" href={page.href} data-astro-prefetch="hover">{page.label}</a>
                <Sym name="chevronRight" size={12} class="crumbs__sep" />
                <span class="crumbs__page" aria-current="page">{title === page.label && subtitle ? subtitle : title}</span>
              </>
            ) : (
              <span class="crumbs__page" aria-current="page">{page?.label ?? title}</span>
            )}
          </nav>
        </div>
        <div class="content">
          {bare ? (
            <h1 class="visually-hidden">{title}</h1>
          ) : (
            <PageHeader title={title} description={subtitle}>
              {Astro.slots.has('actions') && <Fragment slot="actions"><slot name="actions" /></Fragment>}
            </PageHeader>
          )}
          <main id="main" class:list={['main', bare && 'main--bare']}><slot /></main>
        </div>
      </div>

    </div>

    <script>
      import '../scripts/layout/index';
    </script>

    <style>
      /* Le bureau de mistraOS : le fond d'écran, la barre à îlot, la fenêtre de la page, le Dock. */
      .window {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: var(--titlebar-height) minmax(0, 1fr);
        height: 100dvh;
        color: var(--text-primary);
        font-family: var(--font-ui); font-size: var(--body-size); line-height: var(--body-lh);
      }

      .topbar {
        display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--island-gap);
        min-width: 0; padding: 0 var(--window-gap);
        font-family: var(--font-mono);
      }
      .topbar__left { display: flex; min-width: 0; }
      .topbar__right { display: flex; align-items: center; justify-content: flex-end; gap: var(--island-gap); min-width: 0; }

      .capsule {
        display: inline-flex; align-items: center; gap: var(--space-2); min-width: 0;
        height: var(--island-h); padding: 0 var(--island-pad);
        border: 0; border-radius: var(--radius-full);
        font: inherit; font-size: var(--dense-size); line-height: var(--dense-lh);
      }
      .account { padding-left: var(--space-1); }

      /* Les bureaux de mistraOS : une pastille par section, la section ouverte en pilule large. */
      .spaces { gap: var(--space-2); padding: 0 var(--space-3); }
      .space {
        display: block; flex: none; width: var(--space-dot); height: var(--space-dot); border-radius: var(--radius-full);
        background: var(--island-text-dim);
        transition: width var(--dur-spring-toggle) var(--ease-spring-toggle), background-color var(--dur-fade) linear;
      }
      .space:hover { background: var(--island-text); }
      .space[aria-current='true'] { width: var(--space-dot-active); background: var(--island-text); }
      .space:focus-visible { outline-offset: var(--space-0-5); }

      .crumbs { display: flex; align-items: center; justify-content: center; gap: var(--space-1); min-width: 0; color: var(--text-secondary); font-size: var(--dense-size); line-height: var(--dense-lh); }
      .crumbs__sec { white-space: nowrap; }
      .crumbs :global(.crumbs__sep) { flex: none; color: var(--text-tertiary); }
      .crumbs__page { color: var(--text-primary); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .crumbs__link {
        color: inherit; text-decoration: none; white-space: nowrap; padding: var(--space-0-5) var(--space-1); margin: calc(-1 * var(--space-0-5)) calc(-1 * var(--space-1)); border-radius: var(--radius-sm);
        transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
      }
      .crumbs__link:hover { background: var(--bg-hover); color: var(--text-primary); }

      .island {
        display: inline-flex; align-items: center; gap: var(--space-2);
        width: clamp(12rem, 34vw, 25.5rem); height: var(--island-h); padding: 0 var(--space-1) 0 var(--island-pad);
        border: 0; border-radius: var(--radius-full); color: var(--text-secondary);
        font: inherit; font-size: var(--dense-size); line-height: var(--dense-lh); text-align: left; cursor: text;
        transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
      }
      /* Au repos l'îlot est noir, sans rien dessus ; sa loupe et ses mots viennent sous le pointeur. */
      .island > :global(*) { opacity: 0; transition: opacity var(--dur-fade) var(--ease-fade); }
      .island:hover > :global(*), .island:focus-visible > :global(*) { opacity: 1; }
      @media (hover: none) { .island > :global(*) { opacity: 1; } }
      .island:hover { color: var(--text-primary); }
      .island:active { transform: scale(var(--press-scale)); }
      .island__txt { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      :global(.island--away) { opacity: 0; }

      .refresh, .clock { color: var(--text-secondary); white-space: nowrap; }
      .clock { margin: 0; color: var(--text-primary); font-variant-numeric: tabular-nums; }
      .clock:empty { display: none; }
      .refresh__dot { position: relative; width: 7px; height: 7px; border-radius: 50%; background: var(--status-online); flex: none; }
      .refresh__dot::after {
        content: ''; position: absolute; inset: 0; border-radius: 50%; background: inherit;
        animation: n-pulse 2s var(--ease-out) infinite; animation-delay: var(--pulse-phase, 0ms);
      }
      .refresh--paused .refresh__dot { background: transparent; box-shadow: inset 0 0 0 1.5px var(--status-offline); }
      .refresh--paused .refresh__dot::after { animation: none; opacity: 0; }

      .account { cursor: pointer; transition: transform var(--dur-fast) var(--ease-out); }
      .account:active { transform: scale(var(--press-scale)); }
      .account__avatar {
        display: inline-grid; place-items: center; flex: none;
        width: calc(var(--island-h) - 2 * var(--space-1)); height: calc(var(--island-h) - 2 * var(--space-1)); border-radius: var(--radius-full);
        background: var(--bg-hover); color: var(--text-primary); font-size: var(--micro-size); font-weight: 600;
      }
      .account__name { min-width: 0; max-width: 10rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-secondary); }
      .account:hover .account__name, .account[aria-expanded='true'] .account__name { color: var(--text-primary); }

      /* La fenêtre : le cadre porte le rayon et le bord de la fenêtre active, le contenu défile dedans.
         Arrondir la zone qui défile elle-même laisse un trou d'un pixel dans Chromium. */
      .frame {
        display: flex; flex-direction: column; min-width: 0; min-height: 0; margin: 0 var(--window-gap) var(--window-gap); overflow: hidden;
        border: var(--window-border) solid var(--m-border-active); border-radius: var(--window-radius);
        background: var(--bg-app);
      }
      /* La barre de titre des fenêtres de mistraOS (décoration « macos », boutons en couleur). */
      .frame__bar {
        position: relative; display: flex; align-items: center; justify-content: center; flex: none;
        height: var(--window-titlebar); padding: 0 calc(3 * var(--control-size) + 2 * var(--control-gap) + 2 * var(--space-3));
      }
      .lights { position: absolute; left: var(--space-3); top: 50%; translate: 0 -50%; display: flex; gap: var(--control-gap); }
      .lights i { width: var(--control-size); height: var(--control-size); border-radius: var(--radius-full); background: var(--control-close); }
      .lights i:nth-child(2) { background: var(--control-minimize); }
      .lights i:nth-child(3) { background: var(--control-maximize); }
      .content {
        /* En relatif : un élément en absolu du contenu (texte masqué, infobulle) défile avec lui au lieu d'allonger la page. */
        position: relative; display: flex; flex-direction: column; flex: 1;
        min-width: 0; min-height: 0; overflow-y: auto;
        view-transition-name: page;
      }
      .main {
        width: 100%; max-width: var(--content-max); margin-inline: auto;
        padding: var(--space-4) var(--page-gutter) var(--space-8);
        display: flex; flex-direction: column; gap: var(--space-4);
      }
      .main--bare { padding: 0; gap: 0; max-width: none; margin: 0; flex: 1; min-height: 0; }

      /* Le Dock : des tuiles noires qui flottent, une par onglet. */
      /* Dans le code, le Dock précède la fenêtre : au clavier on l'atteint avant le contenu. */
      .topbar { grid-row: 1; } .frame { grid-row: 2; } .dock { grid-row: 3; }
      .dock { display: flex; justify-content: center; min-width: 0; padding: var(--window-gap-inner) var(--window-gap) var(--window-gap); z-index: var(--z-pane); }
      /* À la souris, le Dock se masque comme sur le bureau : il glisse sous le bord et revient quand le pointeur le touche. */
      @media (hover: hover) and (pointer: fine) and (min-width: 640.02px) {
        .dock { position: fixed; inset: auto 0 0 0; padding-top: var(--window-gap); }
        .dock__row { translate: 0 calc(100% + var(--window-gap) + var(--dock-dot)); transition: translate var(--dur-hide) var(--ease-out) var(--dur-hide-delay); }
        .dock:hover .dock__row, .dock:focus-within .dock__row { translate: 0; transition: translate var(--dur-spring-morph) var(--ease-spring-morph); }
      }
      .dock__row { display: flex; align-items: flex-end; gap: var(--dock-gap); height: var(--dock-icon); margin: 0; padding: 0; list-style: none; }
      .dock__cell { display: flex; }
      .dock__sep { align-self: center; width: var(--border-width); height: calc(var(--dock-icon) / 2); margin-inline: var(--dock-gap); background: var(--island-text-dim); }
      .dock__tile {
        position: relative; display: grid; place-items: center; flex: none;
        width: calc(var(--dock-icon) * var(--s, 1)); height: calc(var(--dock-icon) * var(--s, 1));
        border-radius: var(--dock-tile-radius); color: var(--island-text); text-decoration: none;
        box-shadow: var(--shadow-sm);
        transition: width var(--dur-settle) var(--ease-out), height var(--dur-settle) var(--ease-out), filter var(--dur-fast) var(--ease-out);
      }
      .dock__tile:active { filter: brightness(0.7); }
      .dock__tile:focus-visible { outline-offset: var(--space-0-5); outline-color: var(--island-text); }
      .dock__glyph { display: grid; place-items: center; width: 50%; height: 50%; }
      .dock__glyph :global(svg) { width: 100%; height: 100%; }
      /* L'onglet ouvert : un point sous sa tuile, dans la marge du Dock. */
      .dock__tile[aria-current='page']::before {
        content: ''; position: absolute; left: 50%; bottom: calc(-1 * var(--dock-dot) - var(--space-0-5)); translate: -50% 0;
        width: var(--dock-dot); height: var(--dock-dot); border-radius: var(--radius-full); background: var(--island-text);
        box-shadow: 0 0 0 1px var(--island);
      }
      /* Le nom de l'onglet, dans une capsule noire qui monte au-dessus de sa tuile. */
      .dock__tile::after {
        content: attr(data-label); position: absolute; left: 50%; bottom: calc(100% + var(--dock-gap)); translate: -50% var(--dock-gap);
        height: var(--control-h); padding: 0 var(--island-pad); border-radius: var(--radius-full);
        display: grid; place-items: center; white-space: nowrap; pointer-events: none;
        background: var(--island); color: var(--island-text); font-size: var(--dense-size); line-height: var(--dense-lh);
        opacity: 0; transition: opacity var(--dur-settle) var(--ease-out), translate var(--dur-settle) var(--ease-out);
      }
      .dock__tile:hover::after, .dock__tile:focus-visible::after { opacity: 1; translate: -50% 0; }
      .dock__badge {
        position: absolute; top: calc(-1 * var(--space-1)); right: calc(-1 * var(--space-1)); min-width: 18px; height: 18px; padding: 0 5px;
        display: inline-grid; place-items: center; border-radius: var(--radius-full);
        background: var(--island-text); color: var(--island); font-size: var(--micro-size); font-weight: 600; font-variant-numeric: tabular-nums;
      }

      @media (max-width: 900px) {
        .account__name, .island :global(.island__keys), .refresh__txt { display: none; }
        .refresh { padding: 0; width: var(--island-h); justify-content: center; }
        .account { padding: 0 var(--space-1); }
      }
      @media (max-width: 640px), (pointer: coarse) {
        /* Au doigt ou à l'étroit : la rangée défile, les tuiles ne grandissent pas, le nom ne s'affiche pas. */
        .dock { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
        .dock::-webkit-scrollbar { display: none; }
        .dock__row { margin-inline: auto; }
        .dock__tile::after { display: none; }
      }
      @media (max-width: 640px) {
        .window { --window-gap: var(--window-gap-inner); }
        .topbar { grid-template-columns: minmax(0, 1fr) auto auto; }
        .window { grid-template-rows: var(--titlebar-height) minmax(0, 1fr) auto; }
        .frame { margin-bottom: 0; }
        .crumbs__sec, .crumbs__sec + :global(.crumbs__sep) { display: none; }
        .clock { display: none; }
        .island { width: var(--island-h); padding: 0; justify-content: center; cursor: pointer; }
        .island__txt { display: none; }
        .island > :global(*) { opacity: 1; }
      }
      @media (prefers-reduced-motion: reduce) {
        .island:active, .account:active { transform: none; }
        .refresh__dot::after { display: none; }
      }
    </style>

  </body>
</html>
