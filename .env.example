# Configuration du panel. Copiez ce fichier en `.env` (install.sh le fait) et adaptez-le.
# Le panel (serve.mjs), la construction (astro.config.mjs) et les scripts le lisent au démarrage.
# Une variable déjà présente dans l'environnement (Environment= d'une unité systemd) l'emporte.
# Après une modification : redémarrez le panel (systemctl --user restart orvane).
# Une valeur qui commence par ~/ désigne le dossier personnel du compte du panel.
# Les lignes commentées montrent la valeur par défaut.

# ---------------------------------------------------------------------------
# Cœur
# ---------------------------------------------------------------------------

# Adresse d'écoute. 127.0.0.1 : joignable depuis la machine seulement, à exposer par un reverse
# proxy HTTPS (Caddy, nginx) ou `tailscale serve`. Une IP privée (Tailscale, réseau local) est
# possible. N'écoutez jamais en HTTP sur une adresse publique : le panel pilote systemd, les
# fichiers et un terminal. Il refuse de démarrer hors de 127.0.0.1 sans protection par mot de passe.
PANEL_HOST=127.0.0.1

# Port d'écoute. Le redémarrage différé (npm run deploy) et les tâches planifiées de Claude ne
# tournent que sur 4321 : un autre port désigne une copie de test.
PANEL_PORT=4321

# Adresse(s) publique(s) par lesquelles les navigateurs ouvrent le panel, séparées par des
# virgules : https://panel.example.com ou http://mon-serveur.tailnet.ts.net:4321. Requis derrière
# un reverse proxy (sinon les actions du panel répondent 403). Lu à la construction :
# après modification, lancez scripts/update.sh (ou npm run build) puis redémarrez.
PANEL_PUBLIC_URL=

# Dossier des données (comptes, sessions, base SQLite, état des modules). Relatif à la racine du panel.
# PANEL_DATA_DIR=data

# Nom affiché dans l'interface.
# PANEL_NAME=Orvanes

# Adresses toujours administratrices, même si data/users.json est perdu (virgules). Facultatif.
# PANEL_ADMIN_EMAILS=

# Unité systemd utilisateur du panel, pour l'onglet Journaux.
# PANEL_SERVICE=orvane.service

# Terminal du panel : connexion SSH à cette machine avec une clé dédiée (créée par install.sh et
# ajoutée à ~/.ssh/authorized_keys du compte du panel).
# PANEL_SSH_HOST=127.0.0.1
# PANEL_SSH_PORT=22
# PANEL_SSH_USER vide : le compte qui fait tourner le panel.
# PANEL_SSH_USER=
# PANEL_SSH_KEY=~/.ssh/orvane_terminal_ed25519

# Sites (noms d'hôte, virgules) qui partagent la connexion du panel par /api/auth/relais et
# apparaissent sur la page /portail. Vide : aucun.
# PANEL_RELAY_SITES=

# Reverse proxy sur une autre adresse que 127.0.0.1 (virgules) : seuls ceux-ci et la machine peuvent
# fixer X-Forwarded-For, qui sert à limiter les essais de connexion par client.
# PANEL_TRUSTED_PROXIES=

# 1 : autorise le démarrage sans protection hors de 127.0.0.1. À éviter.
# PANEL_ALLOW_OPEN=

# ---------------------------------------------------------------------------
# Module Applications (apps)
# ---------------------------------------------------------------------------
# Dossier où sont créés les projets des nouvelles applications (un sous-dossier par application).
# ORVANE_APPS_DIR=~/apps
# Domaine des sous-domaines publics : une application déclarée « public » dans apps.json reçoit
# l'adresse <id>.<domaine>. Vide : aucune adresse publique déduite (le certificat et le reverse
# proxy restent à configurer à la main).
# ORVANE_APPS_DOMAIN=
# Premier port attribué aux nouvelles applications (127.0.0.1).
# ORVANE_APPS_PORT_MIN=5100
# Dernier port attribué aux nouvelles applications.
# ORVANE_APPS_PORT_MAX=5199

# ---------------------------------------------------------------------------
# Module Claude (claude)
# ---------------------------------------------------------------------------
# Dossier des projets, relatif au dossier personnel de chaque compte (~/dev).
# ORVANE_CLAUDE_PROJECTS_DIR=dev
# Jeton Claude partagé avec les comptes Linux liés (claude setup-token), relatif au dossier
# personnel du panel s'il n'est pas absolu.
# ORVANE_CLAUDE_SHARED_TOKEN_FILE=.config/orvane/claude-shared-token
# Binaire claude à utiliser ; vide : celui fourni avec @anthropic-ai/claude-agent-sdk.
# ORVANE_CLAUDE_BIN=
# Binaire graphify utilisé par l'onglet Graphes du code.
# ORVANE_GRAPHIFY_BIN=~/.local/bin/graphify
# Navigateur utilisé par l'outil create_pdf de Claude.
# CHROME_BIN=google-chrome
# 1 : lance la boucle des tâches planifiées même sur un panel de test (port autre que 4321).
# PANEL_SCHEDULER=
# Jeton OAuth Claude ; vide : celui de ~/.claude/.credentials.json.
# CLAUDE_CODE_OAUTH_TOKEN=
# Clé d'API, en repli pour la liste des modèles quand aucun jeton OAuth n'est disponible.
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Module Messages de contact (contact-messages)
# ---------------------------------------------------------------------------
# Chemin du fichier JSONL où le site enregistre ses messages de contact (une ligne JSON par
# message : id UUID, receivedAt, name, email, message). Vide : module inactif.
# ORVANE_CONTACT_MESSAGES_FILE=

# ---------------------------------------------------------------------------
# Module Bot Discord (discord-bot)
# ---------------------------------------------------------------------------
# Dossier du bot (contient start.sh, .env, database/). Vide : le module affiche comment le
# configurer.
# ORVANE_DISCORD_BOT_DIR=
# Nom affiché dans l'interface.
# ORVANE_DISCORD_BOT_NAME=Bot Discord
# Nom de l'unité systemd utilisateur (systemctl --user) qui lance le bot. Créée par le panel au
# premier démarrage.
# ORVANE_DISCORD_BOT_SERVICE=discord-bot.service
# Script de lancement, relatif au dossier du bot.
# ORVANE_DISCORD_BOT_START=start.sh
# Adresse du tableau de bord web du bot (optionnel) : affiche un bouton dans la page.
# ORVANE_DISCORD_BOT_URL=
# Dépôt git suivi pour les mises à jour, si différent du dossier du bot.
# ORVANE_DISCORD_BOT_GIT_DIR=
# Dossier de la base du bot, relatif à son dossier : c'est lui qui est sauvegardé et restauré.
# ORVANE_DISCORD_BOT_DB_DIR=database

# ---------------------------------------------------------------------------
# Module Docker (docker)
# ---------------------------------------------------------------------------
# Nom d'un projet Compose protégé : arrêt, redémarrage et suppression exigent de retaper son nom.
# Vide : aucun.
# ORVANE_DOCKER_PROTECTED_PROJECT=
# Dossiers hôte supplémentaires jamais montables dans un conteneur, séparés par « : » (le socket
# Docker et le dossier du panel sont toujours refusés).
# ORVANE_DOCKER_BIND_DENY=

# ---------------------------------------------------------------------------
# Module GitHub (github)
# ---------------------------------------------------------------------------
# Dossiers dont chaque sous-dossier direct qui est un dépôt git devient un projet, séparés par « :
# ». Le panel lui-même est toujours listé.
# ORVANE_GITHUB_DIRS=~/dev
# Compte GitHub accepté pour le push et les sauvegardes. Vide : tout dépôt distant.
# ORVANE_GITHUB_OWNER=
# Remote poussé s'il existe dans le dépôt, sinon origin.
# ORVANE_GITHUB_REMOTE=origin
# Fichier du jeton GitHub (accès en écriture aux dépôts), lu à chaque push. Absent : commit
# possible, push par HTTPS impossible.
# ORVANE_GITHUB_TOKEN_FILE=~/.github-token

# ---------------------------------------------------------------------------
# Module Mail (mail)
# ---------------------------------------------------------------------------
# Serveur IMAP, repli quand data/mail.json est absent.
# MAIL_IMAP_HOST=
# Port IMAP (993 : TLS direct, autre : STARTTLS).
# MAIL_IMAP_PORT=993
# Serveur SMTP, repli quand data/mail.json est absent.
# MAIL_SMTP_HOST=
# Port SMTP (465 : TLS direct, autre : STARTTLS).
# MAIL_SMTP_PORT=465
# Adresse e-mail et identifiant de la boîte.
# MAIL_USER=
# Mot de passe de la boîte.
# MAIL_PASSWORD=
# Serveur au certificat auto-signé seulement : autorité à approuver (variable de Node).
# NODE_EXTRA_CA_CERTS=

# ---------------------------------------------------------------------------
# Module Minecraft (minecraft)
# ---------------------------------------------------------------------------
# Dossier du serveur Minecraft (server.properties, mods/, logs/, whitelist.json).
# ORVANE_MINECRAFT_DIR=~/minecraft-server
# Nom de l'unité systemd du serveur (démarrage, arrêt, état).
# ORVANE_MINECRAFT_SERVICE=minecraft
# Compte Linux propriétaire des fichiers du serveur (sudo -u, install -o).
# ORVANE_MINECRAFT_USER=minecraft
# Port du jeu, si server.properties n'en définit pas.
# ORVANE_MINECRAFT_PORT=25565
# Hôte RCON.
# ORVANE_MINECRAFT_RCON_HOST=127.0.0.1
# Port RCON. Vide : valeur rcon.port de server.properties, sinon 25575.
# ORVANE_MINECRAFT_RCON_PORT=
# Mot de passe RCON. Vide : valeur rcon.password de server.properties.
# ORVANE_MINECRAFT_RCON_PASSWORD=
# Dossier des archives minecraft-backup-*.tar.gz listées par le panel.
# ORVANE_MINECRAFT_BACKUP_DIR=
# Script d'archivage lancé par l'action sauvegarde (via sudo -u ORVANE_MINECRAFT_USER). Vide :
# sauvegarde indisponible.
# ORVANE_MINECRAFT_BACKUP_SCRIPT=
# Cache des textures et icônes de mods extraites (textures/, mod-icons/), relatif à la racine du
# panel.
# ORVANE_MINECRAFT_CACHE_DIR=.cache
# Version du client Minecraft dont le jar fournit les textures (npm run textures, faces).
# ORVANE_MINECRAFT_CLIENT_VERSION=1.21.1
# Chemin du jar client pour l'extraction des textures.
# ORVANE_MINECRAFT_CLIENT_JAR=

# ---------------------------------------------------------------------------
# Module Tailscale (tailscale)
# ---------------------------------------------------------------------------
# Chemin de la CLI tailscale, utilisée aussi par « sudo -n » pour les réglages (doit correspondre
# à la règle sudoers).
# ORVANE_TAILSCALE_BIN=/usr/bin/tailscale
# URL de base de l'API Tailscale.
# TAILSCALE_API_BASE=https://api.tailscale.com/api/v2

# --- Magasin des intégrations -------------------------------------------------
# Adresse du Magasin d'où viennent les intégrations (catalogue signé).
# ORVANE_MAGASIN_URL=https://magasin.orvanes.tech
# Publication : seulement sur le serveur qui publie les intégrations (voir le dépôt orvane-magasin).
# ORVANE_MAGASIN_SOURCES=~/dev/orvane-magasin
# ORVANE_MAGASIN_PUBLIC=/var/www/magasin
# ORVANE_MAGASIN_KEY=~/.config/orvane-magasin/cle-privee.pem

# --- Signalements de bug -----------------------------------------------------
# Signalements de bug -> issues GitHub (token fine-grained, droit Issues: write sur le dépôt)
# ORVANE_GITHUB_TOKEN=
# ORVANE_GITHUB_REPO=owner/depot
